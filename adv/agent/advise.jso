:
{
"#desc"
:
{
"cn"
:
"迭代执行任务，自动循环直到完成或达到最大迭代次数"
,
"en"
:
"Iterate task execution, auto-loop until complete or max iterations reached"
}
,
"#synopsis"
:
[
{
"x agent job iter"
:
null
}
,
{
"x agent job iter --dir <path>"
:
null
}
,
{
"x agent job iter --harness <harness>"
:
null
}
]
,
"--harness"
:
{
"#desc"
:
{
"cn"
:
"指定 AI 工具接口"
,
