"init"
:
{
"#subcmd"
:
true
,
"#desc"
:
{
"cn"
:
"交互式初始化配置（选择并设置 zero_harness、one_harness）"
,
"en"
:
"Interactive initialization (select and set zero_harness, one_harness)"
}
}
,
"job"
:
{
"#desc"
:
{
"cn"
:
"管理长期任务（创建、迭代、调整需求）"
,
"en"
:
"Manage long-term tasks (create, iterate, adjust requirements)"
}
,
"#tldr"
:
[
{
"cmd"
:
"x agent job init \"Implement user authentication\""
,
"cn"
:
"示例: 创建新任务"
,
"en"
:
"Example: Create a new task"
}
,
{
"cmd"
:
"x agent job iter"
,
"cn"
:
"示例: 迭代最近创建的任务"
,
"en"
:
"Example: Iterate the most recently created task"
}
,
{
"cmd"
:
"x agent job adjust"
,
"cn"
:
"示例: 调整任务需求描述"
,
"en"
:
"Example: Adjust task requirement description"
}
]
,
"init"
:
{
"#desc"
:
{
"cn"
:
"创建新的长期任务，通过交互式对话澄清需求并写入 TODO.md"
,
"en"
