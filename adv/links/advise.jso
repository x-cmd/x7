:
{
"#desc"
:
{
"cn"
:
"使用 readablelink 模块转换 URL"
,
"en"
:
"Use readablelink module to convert URL"
}
}
,
"--ccmd"
:
{
"#desc"
:
{
"cn"
:
"ccmd 缓存有效期（默认 10m）"
,
"en"
:
"ccmd cache duration (default 10m)"
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"缓存时间"
,
"en"
:
"Cache duration"
}
}
}
,
"--linksopt"
:
{
"#desc"
:
{
"cn"
:
"传递给 links 命令的额外选项"
