{
"#name"
:
{
"sed"
:
null
,
"cn"
:
"为 sed 设计的增强模块"
,
"en"
:
"Enhanced modules for sed"
}
,
"#tldr"
:
[
{
"cmd"
:
"cat test | x sed"
,
"cn"
:
"使用 fzf 为 sed 提供交互式 APP 查找和替换文本"
,
"en"
:
"Use fzf to provide an interactive app for finding and replacing text in sed."
}
]
,
"#subcmd:Enhance"
:
[
"--fzfapp"
,
"--cmd"
]
,
"--fzfapp"
:
{
"#subcmd"
:
true
,
"#desc"
:
{
"cn"
:
"使用 fzf 为 sed 提供交互式 APP"
,
"en"
:
"Using fzf to provide an interactive app for sed"
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"file"
,
"cn"
:
"文件"
}
,
"#exec"
:
"___x_cmd_advise__file"
}
}
,
"--cmd"
:
{
"#subcmd"
:
true
,
"#desc"
:
{
"cn"
:
"直接运行 sed 命令"
,
"en"
:
"Run the sed command directly"
}
}
,
"$ref"
:
"x-cmd-advise://sed/advise.t.jso"
}

