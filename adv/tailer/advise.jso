{
"#name"
:
{
"tailer"
:
null
,
"cn"
:
"消息队列监听"
,
"en"
:
"Message queue tailer"
}
,
"#synopsis"
:
[
{
"x tailer <subcmd> [args]"
:
null
}
]
,
"#desc"
:
{
"cn"
:
"为 Agent 设计的消息队列框架。\n\n支持多 writer 单 reader 模式，用于 A2A (Agent to Agent) 场景的消息通信。\n"
,
"en"
:
"Message queue framework for Agents.\n\nSupports multi-writer single-reader mode for A2A (Agent to Agent) messaging.\n"
}
,
"#tip"
:
[
{
"cn"
:
"使用 run 启动消息监听，使用 send 发送消息。\n设置 ___X_CMD_TAILER_HANDLE 环境变量自定义消息处理器。\n"
,
"en"
:
"Use run to start listener, use send to send messages.\nSet ___X_CMD_TAILER_HANDLE env var to customize message handler.\n"
}
]
,
"#tldr"
:
[
{
"cmd"
:
"x tailer run /tmp/mq"
,
"cn"
:
"示例: 启动消息队列监听"
,
"en"
:
"Example: Start message queue listener"
}
,
{
"cmd"
:
"x tailer send /tmp/mq \"hello world\""
,
"cn"
:
"示例: 发送消息到队列"
,
"en"
:
"Example: Send message to queue"
}
,
{
"cmd"
:
"x tailer run --gc 5000 /tmp/mq"
,
"cn"
:
"示例: 设置 GC 阈值为 5000 条消息"
,
"en"
:
"Example: Set GC threshold to 5000 messages"
}
,
{
"cmd"
:
"x tailer pending /tmp/mq"
,
"cn"
:
"示例: 查询待处理消息数量"
,
"en"
:
"Example: Query pending message count"
}
]
,
"#subcmd:Command"
:
[
"run"
,
"send"
,
"pending"
,
"service"
]
,
"run"
:
{
"#synopsis"
:
"[option] <folder>"
,
"#desc"
:
{
"cn"
:
"启动消息队列监听，持续读取并处理消息"
,
"en"
:
"Start message queue listener, continuously read and process messages"
}
,
"--gc"
:
{
"#desc"
:
{
"cn"
:
"垃圾回收阈值，处理超过此值后轮换队列文件"
,
"en"
:
"Garbage collection threshold, rotate queue file after processing this many messages"
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"消息数量阈值，默认 10000"
,
"en"
:
"Message count threshold, default 10000"
}
}
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"消息队列文件夹路径"
,
"en"
:
"Message queue folder path"
}
,
"#exec"
:
"___x_cmd_advise__dir"
}
}
,
"send"
:
{
"#synopsis"
:
"<folder> <message>"
,
"#desc"
:
{
"cn"
:
"向消息队列发送消息"
,
"en"
:
"Send message to the queue"
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"消息队列文件夹路径"
,
"en"
:
"Message queue folder path"
}
,
"#exec"
:
"___x_cmd_advise__dir"
}
,
"#2"
:
{
"#desc"
:
{
"cn"
:
"要发送的消息（不能包含换行符）"
,
"en"
:
"Message to send (must not contain newlines)"
}
}
}
,
"pending"
:
{
"#synopsis"
:
"<folder>"
,
"#desc"
:
{
"cn"
:
"查询消息队列中待处理的消息数量"
,
"en"
:
"Query the number of pending messages in the queue"
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"消息队列文件夹路径"
,
"en"
:
"Message queue folder path"
}
,
"#exec"
:
"___x_cmd_advise__dir"
}
}
,
"service"
:
{
"#desc"
:
{
"cn"
:
"管理网关服务"
,
"en"
:
"Manage Gateway Service"
}
,
"start"
:
{
"#desc"
:
{
"cn"
:
"启动网关服务"
,
"en"
:
"Start Gateway service"
}
}
,
"stop"
:
{
"#desc"
:
{
"cn"
:
"停止网关服务"
,
"en"
:
"Stop Gateway service"
}
}
,
"status"
:
{
"#desc"
:
{
"cn"
:
"查看网关服务"
,
"en"
:
"Show gateway service status + probe the Gateway"
}
}
,
"log"
:
{
"#desc"
:
{
"cn"
:
"查看网关服务日志"
,
"en"
:
"Show gateway service log"
}
}
}
,
"#tag"
:
[
"inner"
]
,
"#other"
:
{
"en"
:
{
"Please visit our homepage for more information:"
:
"https://x-cmd.com"
}
,
"cn"
:
{
"请访问我们的主页以获取更多信息："
:
"https://x-cmd.com"
}
}
}

