{
"#name"
:
{
"whisper"
:
null
,
"cn"
:
"为 whisper.cpp 设计的增强模块"
,
"en"
:
"Enhanced modules for whisper.cpp"
}
,
"#desc"
:
{
"en"
:
"Local AI speech recognition. For more information about whisper.cpp, please visit https://github.com/ggerganov/whisper.cpp"
,
"cn"
:
"使用 whisper.cpp 进行本地 AI 语音识别. 关于 whisper.cpp，请访问 https://github.com/ggerganov/whisper.cpp"
}
,
"#tip"
:
[
{
"en"
:
"- First-time users will automatically download whisper.cpp.\n"
,
"cn"
:
"- 第一次使用的用户会自动下载 whisper.cpp\n"
}
]
,
"#tldr"
:
[
{
"cmd"
:
"x whisper <audio file>"
,
"en"
:
"Interactively select the model and recognize the audio file as text"
,
"cn"
:
"交互式选择模型，并将音频文件识别成文字"
}
,
{
"cmd"
:
"x whisper -m medium -f <audio file>"
,
"en"
:
"Use the medium model for audio recognition"
,
"cn"
:
"使用 medium 模型进行音频识别"
}
,
{
"cmd"
:
"x whisper dictate --srt -o test <audio file>"
,
"en"
:
"Save the results to a test.srt subtitle file"
,
"cn"
:
"将结果保存到 test.srt 字幕文件"
}
,
{
"cmd"
:
"x whisper merge <srt file> <video file>"
,
"en"
:
"Merge srt subtitles into your video"
,
"cn"
:
"将 srt 字幕嵌入到视频中"
}
]
,
"-f|--file"
:
{
"#synopsis"
:
"<file dir>"
,
"#desc"
:
{
"en"
:
"The file path of the audio file to be recognized"
,
"cn"
:
"需要识别的音频文件路径"
}
,
"#1"
:
{
"#exec"
:
"___x_cmd_advise__file"
}
}
,
"-m|--model"
:
{
"#synopsis"
:
"<name>"
,
"#desc"
:
{
"en"
:
"Explicitly specify the model for recognition"
,
"cn"
:
"显式指定模型进行识别"
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"model name"
,
"cn"
:
"模型名称"
}
,
"#exec:stdout"
:
"xrc whisper; ___x_cmd_whisper___advise_model_ls"
}
}
,
"dictate"
:
{
"#desc"
:
{
"en"
:
"Speech to Text"
