{
  "lang": "go",
  "homepage": "https://sing-box.sagernet.org/",
  "desc": {
    "cn": "通用代理平台",
    "en": "The universal proxy platform"
  },
  "rule": {
    "/curl": {
      "cmd": "curl -fsSL https://sing-box.app/install.sh | sh",
      "reference": "https://sing-box.sagernet.org/installation/package-manager/"
    },
    "darwin/brew": {
      "cmd": "brew install sing-box",
      "reference": "https://sing-box.sagernet.org/installation/package-manager/"
    },
    "alpine/apk": {
      "cmd": "apk add sing-box",
      "reference": "https://sing-box.sagernet.org/installation/package-manager/",
      "dsnap": "sing-box"
    },
    "ubuntu/apt": {
      "cmd": "apt install sing-box",
      "reference": "https://sing-box.sagernet.org/installation/package-manager/",
      "dsnap": "sing-box"
    },
    "debian/apt": {
      "cmd": "apt install sing-box",
      "reference": "https://sing-box.sagernet.org/installation/package-manager/",
      "dsnap": "sing-box"
    },
    "(win|wsl2)/scoop": {
      "cmd": "scoop install sing-box",
      "reference": "https://sing-box.sagernet.org/installation/package-manager/"
    },
    "(win|wsl2)/choco": {
      "cmd": "choco install sing-box",
      "reference": "https://sing-box.sagernet.org/installation/package-manager/"
    },
    "(win|wsl2)/winget": {
      "cmd": "winget install sing-box",
      "reference": "https://sing-box.sagernet.org/installation/package-manager/"
    }
  }
}
