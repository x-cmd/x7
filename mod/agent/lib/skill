# shellcheck shell=dash

___x_cmd_agent_skill(){
    [ "$#" -gt 0 ] || set -- --help
    local op="$1"; shift
    case "$op" in
        dir)        ___x_cmd_agent_skill_dir "$@" ;;
        -h|--help)  ___x_cmd help -m agent skill "$@" ; return 0 ;;
        *)          set -- "$op" "$@"; ___x_cmd skill "$@" ;;
    esac
}

___x_cmd_agent_skill_dir(){
    local op=""
    local ws=""
    while [ $# -gt 0 ]; do
        case "$1" in
            sum)            op="sum";       shift ;;
            --ws)           ws="$2";        arg:2:shift ;;
            -h|--help)      ___x_cmd help -m agent skill dir "$@"; return 0 ;;
            *)              N=agent M="Unknown option -> $1" log:ret:64 ;;
        esac
    done

    [ "$op" = "sum" ] || { ___x_cmd help -m agent skill dir; return 1; }
    [ -n "$ws" ] || { N=agent M="Missing --ws argument" log:ret:64; }
    [ -d "$ws" ] || { N=agent M="Workspace not found -> $ws" log:ret:64; }

    local found=0
    local first=1
    local d_
    for d_ in "$ws/.claude/skills" "$ws/.agents/skills" "$ws/.codex/skills" "$ws/.gemini/skills" "$ws/.opencode/skills"; do
        [ -d "$d_" ] || continue
        found=1
        if [ "$first" = "1" ]; then
            ___x_cmd skill ls --skill-dir "$d_" 2>/dev/null || true
            first=0
        else
            ___x_cmd skill ls --skill-dir "$d_" 2>/dev/null | ___x_cmd_cmds tail -n +2 || true
        fi
    done

    [ "$found" = "1" ] || agent:info "No skill directories found in workspace: $ws"
}
