# shellcheck shell=dash

___x_cmd log init   alpine

___X_CMD_ALPINE_PREFIX=xal

# xal
# xal jq
# xal snap jq
# xal refit
# xal x gh
# xal init
# xal img refit
# xal img create
# xal img refit
# xal img ls

# xal xub xka

# xd refit xal-base
# xd refit xal-jq

# xal jq
# xal go/github.com/gosop/gosop:gosop

# xal go/github.com/gosop/gosop:gosop

# xal

___x_cmd_alpine___main(){
    [ "$#" -gt 0 ]  || set -- bash

    local op="$1";      shift
    case "$op" in
        -h|--help)      ___x_cmd help -m alpine         "$@" ;;

        img|image)      ___x_cmd_alpine_image           "$@" ;;

        refit|ps|fz)    ___x_cmd_alpine_"$op"           "$@" ;;

        init|cfg)       ___x_cmd_alpine_cfg             "$@" ;;
        --|snap)        ___x_cmd_alpine_snap            "$@" ;;

        :*)             ___x_cmd_alpine_snapx "$op"     "$@" ;;

        *)              ___x_cmd_alpine_snap "$op"      "$@" ;;
    esac
}

___x_cmd_alpine___app(){
    ___x_cmd_alpine container ps    "$@"
}

# TODO: add more commands requiring sudo
___x_cmd_alpine_apk(){
    ___x_cmd_alpine_snap --user root x apk "$@"
}

___x_cmd_alpine_ps(){
    ___x_cmd docker ps \
        --prefix "xal" \
        -a "$@"
}

___x_cmd_alpine_image(){
    ___X_CMD_DOCKER_IMAGE_PREFIX="xal-" \
        ___x_cmd docker image "$@"
}

___x_cmd_alpine_fz(){
    ___X_CMD_DOCKER_PS_PREFIX="xal-"        \
    ___X_CMD_DOCKER_IMAGE_PREFIX="xal-"     \
        ___x_cmd docker fz  "$@"
}

# Scenario 1:
# xal snap yq --version

# xal snap --apk yq yq --version

# Scenario 2:
# xal refit --apk yq xal/yq
# xal snap --image yq xal/yq --version

# Scenario 3:
# xal refit --apk yq --image yq
# xal daemon run --name yq xal/yq
# xal daemon snap yq yq

# go version
# x alpine refit --go github.com/x-cmd.org/gosop@latest -i xal/gosop
# x alpine snap --image gosop gosop "$@"

# Scenario 5: how to use solo in alpine ...
# x alpine snap x a.py
# xal x a.py -> using root ?
# x a.py

___x_cmd_alpine_snap(){
    ___x_cmd docker snap --imagetype alpine "$@"
}

___x_cmd_alpine_snapx(){
    ___X_CMD_DOCKER_IMGTYPE=alpine  \
        ___x_cmd docker snapx "$@"
}

