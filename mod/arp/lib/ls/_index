# shellcheck shell=dash disable=SC2016

# If there is a mac address with the more than 1 ip, high light it.

___x_cmd_arp_ls(){

    local format=app
    local all=no

    while [ $# -gt 0 ]; do
        case "$1" in
            -c|--csv)   format=csv;     shift ;;
            -t|--tsv)   format=tsv;     shift ;;
            -r|--raw)   format=raw;     shift ;;
            -a|--all)   all=yes;        shift ;;
            -*)         N=arp M="Unknown option -> $1" log:ret:64 ;;
            *)          break ;;
        esac
    done

    ___x_cmd_arp_ls_"$format" "$@"
}


___x_cmd_arp_ls_raw(){
    [ $# -gt 0 ] || set -- -a

    if      ___x_cmd_hascmd arp;    then    ___x_cmd_cmds       arp -n "$@"
    elif    ___x_cmd os is linux;   then    ___x_cmd busybox    arp -n "$@"
    else                                    N=arp M="Command not found -> arp" log:ret:1
    fi
}


___x_cmd_arp_ls_xsv(){
    ___x_cmd_arp_ls_raw | \
        ___x_cmd_cmds awk -v OFS="$1" -v all="$all" \
            -f "$___X_CMD_ROOT_MOD/arp/lib/ls/parse_xsv.awk"
}

___x_cmd_arp_ls_csv(){
    ___x_cmd_arp_ls_xsv ","
}

___x_cmd_arp_ls_tsv(){
    ___x_cmd_arp_ls_xsv "\t"
}

___x_cmd_arp_ls_app___sort(){
    read -r line;
    printf "%s\n" "$line"
    ___x_cmd_cmds sort -k 2,1
}

___x_cmd_arp_ls_app(){
    ___x_cmd_arp_ls_csv | ___x_cmd csv app
}

___x_cmd_arp_ls_app___colorize(){
    ___x_cmd_cmds cat
}
