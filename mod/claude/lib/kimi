
___x_cmd_claude_kimi(){
    [ "$#" -gt 0 ] ||   set -- --runcmd

    local op="$1";      shift
    case "$op" in
        -h|--help)      ___x_cmd help -m claude kimi "$@";    return 0 ;;
        --runcmd)       ___x_cmd_claude_kimi___runcmd       "$@" ;;
        *)              ___x_cmd_claude_kimi___runcmd "$op" "$@" ;;
    esac
}

___x_cmd_claude_kimi___runcmd(){
    local url="${ANTHROPIC_BASE_URL:-"https://api.moonshot.cn/anthropic"}"
    local token="${ANTHROPIC_AUTH_TOKEN}"
    local model="${ANTHROPIC_MODEL:-"kimi-k2-turbo-preview"}"
    local fast_model="${ANTHROPIC_SMALL_FAST_MODEL:-"kimi-k2-turbo-preview"}"

    [ -n "$token" ] || token="${MOONSHOT_API_KEY:-$(___x_cmd moonshot --cur get apikey 2>/dev/null)}"

    ANTHROPIC_BASE_URL="${url}"                                        \
    ANTHROPIC_AUTH_TOKEN="${token}"                                    \
    ANTHROPIC_MODEL="${model}"                                         \
    ANTHROPIC_SMALL_FAST_MODEL="${fast_model}"                         \
        ___x_cmd_claude___runcmd "$@"
}
