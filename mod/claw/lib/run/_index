
# claw = memory + soul + note + tailer-mq + cron

xrc:mod:lib     claw   run/heartbeat   run/msg  run/agentrequest   run/util run/log

___X_CMD_CLAW_DIR="$___X_CMD_ROOT_DATA/claw"
___X_CMD_CLAW_BOT_WS="$___X_CMD_CLAW_DIR/workspace/default"
___X_CMD_CLAW_BOT_MQ="$___X_CMD_CLAW_BOT_WS/.x-cmd/tailer-mq"
___X_CMD_CLAW_BOT_DATA="$___X_CMD_CLAW_BOT_WS/.x-cmd/data"
___X_CMD_CLAW_BOT_HEARTBEAT="$___X_CMD_CLAW_BOT_DATA/heartbeat"
___X_CMD_CLAW_BOT_STDOUT_LOG_DIR="$___X_CMD_CLAW_BOT_DATA/logs"

___x_cmd_claw_run(){
    [ "$#" -gt 0 ] || set -- --help
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --help|-h)  ___x_cmd help -m claw run ; return 0 ;;
            --)         shift ; break ;;
            *)          break ;;
        esac
    done

    local im="${1:-"weixin"}"
    ___x_cmd_claw_run___ensure "$im" || return $?
    ___x_cmd touch "$___X_CMD_CLAW_BOT_HEARTBEAT/im_activity/$im"

    claw:info "X-Claw agent runtime active on $im — awaiting instructions and ready to act"
    # claw:info "Use 'x claw log' to view real-time agent logs"

    if ! ___x_cmd worker isalive --ns x-claw-default-worker --name heartbeat-runner; then
        claw:debug "Starting heartbeat worker"
        ___x_cmd worker run --ns x-claw-default-worker --name heartbeat-runner -- ___x_cmd_claw_run_hearbeatgenerator "$___X_CMD_CLAW_BOT_MQ" "$im"
    fi

    claw:debug "Entering tailer loop to process incoming MQ messages"
    (
        trap '' INT

        ___X_CMD_TAILER_HANDLE="___x_cmd_claw_run___agentwork" \
        ___x_cmd tailer run "$___X_CMD_CLAW_BOT_MQ"
    ) || {
        local exitcode="$?"
        claw:warn "Tailer loop exited with code $exitcode — initiating teardown"
        ___x_cmd_claw_run___teardown
        return "$exitcode"
    }

    ___x_cmd_claw_run___teardown
}

___x_cmd_claw_run___teardown(){
    claw:info "Shutting down X-Claw runtime — stopping services and cleaning up state"

    claw:debug "Removing IM activity state directory: $___X_CMD_CLAW_BOT_HEARTBEAT/im_activity"
    ___x_cmd rmrf "$___X_CMD_CLAW_BOT_HEARTBEAT/im_activity"

    claw:debug "Stopping heartbeat worker (namespace: x-claw-default-worker, name: heartbeat-runner)"
    ___x_cmd worker stop --ns x-claw-default-worker --name heartbeat-runner
}

___x_cmd_claw_run___agentwork(){
    ___x_cmd log timestamp epoch

    local msg="$1"
    case "$msg" in
        HEARTBEAT:*)
            ___x_cmd_claw_run___agentwork___heartbeat "${msg#*:}"   ;;
        weixin:*|qywx:*|feishu:*|telegram:*)
            ___x_cmd_claw_run___agentwork___handlemsg "$msg"        ;;

        # other agents.
    esac
}

___x_cmd_claw_run___ensure(){
    ___x_cmd agent isready || {
        claw:error "Agent is not ready. Please run 'x agent init' to setup the agent first."
        return 1
    }

    local im="${1:-"weixin"}"
    case "$im" in
        weixin)
            ___x_cmd tailer sub "$___X_CMD_ROOT_DATA/weixin/sub" x-claw-default "$___X_CMD_CLAW_BOT_MQ" || return $?
            ___x_cmd weixin bot service ensure || return $?
            ;;
        telegram)
            ___x_cmd tailer sub "$___X_CMD_ROOT_DATA/telegram/sub" x-claw-default "$___X_CMD_CLAW_BOT_MQ" || return $?
            ___x_cmd telegram bot service ensure || return $?
            ;;
        feishu)
            ___x_cmd tailer sub "$___X_CMD_ROOT_DATA/feishu/sub" x-claw-default "$___X_CMD_CLAW_BOT_MQ" || return $?
            ___x_cmd feishu abot service ensure || return $?
            ;;
        qywx)
            ___x_cmd tailer sub "$___X_CMD_ROOT_DATA/qywx/sub" x-claw-default "$___X_CMD_CLAW_BOT_MQ" || return $?
            ___x_cmd qywx abot service ensure || return $?
            ;;
        *)  claw:error "Unsupported IM platform: $im"
            return 1
            ;;
    esac
}
