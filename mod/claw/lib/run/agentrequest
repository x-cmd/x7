# shellcheck shell=dash

___x_cmd_claw_agentrequest(){
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --help|-h)              ___x_cmd help -m claw agentrequest; return 0 ;;
            *)                      break ;;
        esac
    done

    if [ -z "$___X_CMD_CLAW_AGENT_REFERENCE_WS" ]; then
        ___X_CMD_CLAW_AGENT_REFERENCE_WS="$HOME/.openclaw/workspace"
    fi

    local im="$1";      [ -n "$im" ] || N=claw M="Please provide IM platform name (e.g., weixin|telegram)" log:ret:64
    local chatid="$2";  [ -n "$chatid" ] || N=claw M="Please provide chatid" log:ret:64

    ___x_cmd_claw_run___ensure "$im" || return $?
    ___x_cmd_claw_run___agentrequest___handlemsg "$@"
}

___x_cmd_claw_run___agentrequest___handlemsg(){
    local im="$1";      [ -n "$im" ] || N=claw M="Please provide IM platform name (e.g., weixin|telegram)" log:ret:64
    local chatid="$2";  [ -n "$chatid" ] || N=claw M="Please provide chatid" log:ret:64
    local msg="$3";     [ -n "$msg" ] || N=claw M="Please provide message" log:ret:64

    if [ -n "$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR" ]; then
        local logfp="$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR/${im}-${chatid}.log"
        ___x_cmd ensurefp "$logfp"
        exec >>"$logfp" 2>&1
    fi

    ___x_cmd_claw_run___agentrequest___checkunavailable || return 0

    ___x_cmd rmrf "$___X_CMD_CLAW_BOT_WS/HEARTBEAT_DONE"
    ___x_cmd ensurefp "$___X_CMD_CLAW_BOT_HEARTBEAT/idle_count"
    printf "%s\n" "0" > "$___X_CMD_CLAW_BOT_HEARTBEAT/idle_count"

    local workspace_dir="$___X_CMD_CLAW_BOT_WS/${im}-${chatid}"
    local exitcode=0

    # Initialize workspace from template if first run
    if [ ! -d "$workspace_dir" ]; then
        first_contact_prompt="$(___x_cmd_cmds cat "$___X_CMD_ROOT_MOD/claw/lib/data/prompt/first_contact.md" 2>/dev/null)"
        ___x_cmd cp -r "$___X_CMD_ROOT_MOD/claw/lib/data/workspace/msg" "$workspace_dir"
    else
        # Ensure missing template files are present without overwriting existing ones
        local i; for i in "$___X_CMD_ROOT_MOD/claw/lib/data/workspace/msg"/*; do
            [ -e "$i" ] || continue
            target="$workspace_dir/${i##*/}"
            [ -e "$target" ] || ___x_cmd cp -r "$i" "$target"
        done
    fi

    claw:info "Processing agent request for $im:$chatid"
    case "$im" in
        weixin)
            ___x_cmd agent request  \
                --timeout 1800 \
                --workspace "$workspace_dir"  \
                --reference-workspace "$___X_CMD_CLAW_AGENT_REFERENCE_WS" \
                "You have received a message from a user via WeChat.
${first_contact_prompt}

REPLY METHOD:
Use the command 'x weixin send' to reply:
- For help:        x weixin send -h
- For text:        x weixin send --text '<msg>'
- For image/video: x weixin send --image <path>  or  x weixin send --video <path>

CRON EXAMPLES:
- To add:        x cron add --ns \"x-claw-default\" --name \"<name>\" --desc \"<desc>\" \"<cron_expr>\" \"x claw agentrequest $im $chatid '<msg>'\"
                   CRITICAL: <msg> goes to a NEW agent with ZERO memory. Include: Goal, Tools, Steps, Output, and Delivery command.
                   TIP: Use SINGLE quotes for the message text (e.g. x weixin send --text '<result>').
                   BAD:  'Check HN' — too vague, agent won't know what to do.
                   GOOD: 'Use x hn top for top 5 posts. Extract title, URL, score. Send: x weixin send --text '<formatted_list>''

Your workspace: \"$workspace_dir\"

Current time: '$(___x_cmd date iso)'
---
$msg
"
            ;;
        telegram)
            ___x_cmd agent request  \
                --timeout 1800 \
                --workspace "$workspace_dir"  \
                --reference-workspace "$___X_CMD_CLAW_AGENT_REFERENCE_WS" \
                "You have received a message from a user via Telegram.
${first_contact_prompt}

CURRENT CHAT ID: \"$chatid\" — you MUST include this in every reply command.

REPLY METHOD:
Use the command 'x telegram send' to reply:
- For help:        x telegram send -h
- For text:        \`x telegram send --text --chatid \"$chatid\" '<msg>'\`
- For image/video: x telegram send --image --chatid \"$chatid\" <path>  or  x telegram send --video --chatid \"$chatid\" <path>

CRON EXAMPLES:
- To add:        x cron add --ns \"x-claw-default\" --name \"<name>\" --desc \"<desc>\" \"<cron_expr>\" \"x claw agentrequest $im $chatid '<msg>'\"
                   CRITICAL: <msg> goes to a NEW agent with ZERO memory. Include: Goal, Tools, Steps, Output, and Delivery command.
                   TIP: Use SINGLE quotes for the message text (e.g. x telegram send --text --chatid \"$chatid\" '<result>').
                   BAD:  'Check HN' — too vague, agent won't know what to do.
                   GOOD: 'Use x hn top for top 5 posts. Extract title, URL, score. Send: x telegram send --text --chatid \"$chatid\" '<formatted_list>''

Your workspace: \"$workspace_dir\"

Current time: '$(___x_cmd date iso)'
---
$msg
"
            ;;
        feishu)
            ___x_cmd agent request  \
                --timeout 1800 \
                --workspace "$workspace_dir"  \
                --reference-workspace "$___X_CMD_CLAW_AGENT_REFERENCE_WS" \
                "You have received a message from a user via Feishu.
${first_contact_prompt}

CURRENT CHAT ID: \"$chatid\" — you MUST include this in every reply command.

REPLY METHOD:
Use the command 'x feishu abot send' to reply:
- For help:        x feishu abot send -h
- For text:        \`x feishu abot send --text --chatid \"$chatid\" '<msg>'\`
- For image/video: x feishu abot send --image --chatid \"$chatid\" <path>  or  x feishu abot send --video --chatid \"$chatid\" <path>

CRON EXAMPLES:
- To add:        x cron add --ns \"x-claw-default\" --name \"<name>\" --desc \"<desc>\" \"<cron_expr>\" \"x claw agentrequest $im $chatid '<msg>'\"
                   CRITICAL: <msg> goes to a NEW agent with ZERO memory. Include: Goal, Tools, Steps, Output, and Delivery command.
                   TIP: Use SINGLE quotes for the message text (e.g. x feishu abot send --text --chatid \"$chatid\" '<result>').
                   BAD:  'Check HN' — too vague, agent won't know what to do.
                   GOOD: 'Use x hn top for top 5 posts. Extract title, URL, score. Send: x feishu abot send --text --chatid \"$chatid\" '<formatted_list>''

Your workspace: \"$workspace_dir\"

Current time: '$(___x_cmd date iso)'
---
$msg
"
            ;;
        qywx)
            ___x_cmd agent request  \
                --timeout 1800 \
                --workspace "$workspace_dir"  \
                --reference-workspace "$___X_CMD_CLAW_AGENT_REFERENCE_WS" \
                "You have received a message from a user via Qywx (Enterprise WeChat).
${first_contact_prompt}

CURRENT CHAT ID: \"$chatid\" — you MUST include this in every reply command.

REPLY METHOD:
Use the command 'x qywx abot send' to reply:
- For help:        x qywx abot send -h
- For text:        \`x qywx abot send --text --chatid \"$chatid\" '<msg>'\`
- For image/file: x qywx abot send --image --chatid \"$chatid\" <path>  or  x qywx abot send --file --chatid \"$chatid\" <path>

CRON EXAMPLES:
- To add:        x cron add --ns \"x-claw-default\" --name \"<name>\" --desc \"<desc>\" \"<cron_expr>\" \"x claw agentrequest $im $chatid '<msg>'\"
                   CRITICAL: <msg> goes to a NEW agent with ZERO memory. Include: Goal, Tools, Steps, Output, and Delivery command.
                   TIP: Use SINGLE quotes for the message text (e.g. x qywx abot send --text --chatid \"$chatid\" '<result>').
                   BAD:  'Check HN' — too vague, agent won't know what to do.
                   GOOD: 'Use x hn top for top 5 posts. Extract title, URL, score. Send: x qywx abot send --text --chatid \"$chatid\" '<formatted_list>''

Your workspace: \"$workspace_dir\"

Current time: '$(___x_cmd date iso)'
---
$msg
"
            ;;
    esac || exitcode="$?"

    if [ "$exitcode" -eq 0 ]; then
        claw:info "Successfully processed agent request for $im:$chatid"
        ___x_cmd rmrf "$___X_CMD_CLAW_BOT_HEARTBEAT/agent_unavailable"
    else
        claw:error "Failed to process agent request for $im:$chatid - marking agent as unavailable"
        ___x_cmd_claw_run___agentrequest___markunavailable
        return "$exitcode"
    fi
}

___x_cmd_claw_run___agentrequest___handleheartbeat(){
    if [ -n "$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR" ]; then
        local logfp="$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR/heartbeat.log"
        ___x_cmd ensurefp "$logfp"
        exec >>"$logfp" 2>&1
    fi

    ___x_cmd_claw_run___agentrequest___checkunavailable || return 0

    local imdir="$___X_CMD_CLAW_BOT_HEARTBEAT/im_activity"
    [ -d "$imdir" ] || {
        claw:warn "[HB] No IM activity directory found. Skipping heartbeat."
        return 0
    }

    local active_platforms=""
    local reply_methods=""
    local default_reply_im=""
    local default_reply_chatid=""
    local max_ts=0
    local im_count=0

    local i active_im active_chatid active_ts x_
    for i in "$imdir"/*; do
        [ -f "$i" ] || continue
        active_im="${i##*/}"
        read -r active_chatid active_ts < "$i"
        [ -n "$active_chatid" ] || continue
        [ -n "$active_ts" ] || continue

        im_count=$((im_count + 1))

        x_=""; ___x_cmd epoch minus_ -H "$active_ts"
        active_platforms="$active_platforms
  - $active_im (chatid: $active_chatid, last_active: $x_)"

        # Build reply method hints for this platform
        case "$active_im" in
            weixin)
                reply_methods="$reply_methods
  * weixin:   x weixin send --text '<msg>'" ;;
            telegram)
                reply_methods="$reply_methods
  * telegram: x telegram send --text --chatid \"$active_chatid\" '<msg>'" ;;
            feishu)
                reply_methods="$reply_methods
  * feishu:   x feishu abot send --text --chatid \"$active_chatid\" '<msg>'" ;;
            qywx)
                reply_methods="$reply_methods
  * qywx:     x qywx abot send --text --chatid \"$active_chatid\" '<msg>'" ;;
            *)
                reply_methods="$reply_methods
  * $active_im: x $active_im send --text --chat \"$active_chatid\" '<msg>'" ;;
        esac

        # Find the most recently active platform
        if [ "$active_ts" -gt "$max_ts" ]; then
            max_ts="$active_ts"
            default_reply_im="$active_im"
            default_reply_chatid="$active_chatid"
        fi
    done

    [ "$im_count" -gt 0 ] || {
        claw:warn "[HB] No active platforms found. Skipping heartbeat."
        return 0
    }

    local workspace_dir="$___X_CMD_CLAW_BOT_WS"

    # Initialize global workspace from heartbeat template if first run
    if [ ! -d "$workspace_dir" ]; then
        ___x_cmd cp -r "$___X_CMD_ROOT_MOD/claw/lib/data/workspace/hb" "$workspace_dir"
    else
        # Ensure missing template files are present without overwriting existing ones
        local i; for i in "$___X_CMD_ROOT_MOD/claw/lib/data/workspace/hb"/*; do
            [ -e "$i" ] || continue
            target="$workspace_dir/${i##*/}"
            [ -e "$target" ] || ___x_cmd cp -r "$i" "$target"
        done
    fi

    claw:info "[HB] Processing global heartbeat for $im_count platform(s), default reply to $default_reply_im"

    ___x_cmd agent request \
        --timeout 1800 \
        --workspace "$workspace_dir"  \
        --reference-workspace "$___X_CMD_CLAW_AGENT_REFERENCE_WS" \
        "You are a heartbeat agent — a background process that wakes up periodically to check workspace state, review context, and surface anything worth the user's attention. Current time: '$(___x_cmd date iso)'.

ACTIVE PLATFORMS:$active_platforms

DEFAULT REPLY TARGET: $default_reply_im (most recent)

REPLY METHODS:$reply_methods
- Your workspace:             \"$workspace_dir\"
" || {
        claw:error "[HB] Global heartbeat agent request failed for $im_count platform(s)"
        ___x_cmd_claw_run___agentrequest___markunavailable
        return 1
    }

    # Heartbeat agent succeeded — clear unavailable status
    ___x_cmd rmrf "$___X_CMD_CLAW_BOT_HEARTBEAT/agent_unavailable"
}

___x_cmd_claw_run___agentrequest___checkunavailable(){
    local agent_unavailable_file="$___X_CMD_CLAW_BOT_HEARTBEAT/agent_unavailable"
    [ -f "$agent_unavailable_file" ] || return 0

    local fail_count=0 fail_ts=0
    read -r fail_count fail_ts < "$agent_unavailable_file"

    local cooldown
    case "$fail_count" in
        1) cooldown=120 ;;
        2) cooldown=240 ;;
        3) cooldown=480 ;;
        4) cooldown=960 ;;
        5) cooldown=1920 ;;
        *) cooldown=3600 ;;
    esac

    local x_
    ___x_cmd date timestamp_
    local elapsed=$(( x_ - fail_ts ))
    if [ "$elapsed" -lt "$cooldown" ]; then
        local remaining=$(( cooldown - elapsed ))
        claw:info "Agent unavailable (fail_count=$fail_count), ${remaining}s cooldown remaining — skipping request"
        return 1
    fi

    claw:info "Agent cooldown expired (fail_count=$fail_count, cooldown=${cooldown}s) — availability restored"
    return 0
}

___x_cmd_claw_run___agentrequest___markunavailable(){
    local agent_unavailable_file="$___X_CMD_CLAW_BOT_HEARTBEAT/agent_unavailable"
    local fail_count=0; local _=""
    [ ! -f "$agent_unavailable_file" ] || read -r fail_count _ < "$agent_unavailable_file"
    fail_count=$(( fail_count + 1 ))

    local x_
    ___x_cmd date timestamp_
    ___x_cmd ensurefp "$agent_unavailable_file"
    printf "%s %s\n" "$fail_count" "$x_" > "$agent_unavailable_file"
    claw:error "Agent marked unavailable (fail_count=$fail_count) — cooldown starts"
}
