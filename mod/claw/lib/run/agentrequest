# shellcheck shell=dash

___x_cmd_claw_agentrequest(){
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --help|-h)              ___x_cmd help -m claw agentrequest; return 0 ;;
            *)                      break ;;
        esac
    done

    if [ -z "$___X_CMD_CLAW_AGENT_REFERENCE_WS" ]; then
        ___X_CMD_CLAW_AGENT_REFERENCE_WS="$HOME/.openclaw/workspace"
    fi

    local im="$1";      [ -n "$im" ] || N=claw M="Please provide IM platform name (e.g., weixin|telegram)" log:ret:64
    local chatid="$2";  [ -n "$chatid" ] || N=claw M="Please provide chatid" log:ret:64

    ___x_cmd_claw_run___ensure_im_service "$im" "$chatid" || return $?
    ___x_cmd_claw_run___agentrequest___handlemsg "$@"
}

___x_cmd_claw_run___agentrequest___handlemsg(){
    local im="$1";      [ -n "$im" ] || N=claw M="Please provide IM platform name (e.g., weixin|telegram)" log:ret:64
    local chatid="$2";  [ -n "$chatid" ] || N=claw M="Please provide chatid" log:ret:64
    local msg="$3";     [ -n "$msg" ] || N=claw M="Please provide message" log:ret:64

    if [ -n "$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR" ]; then
        local logfp="$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR/${im}-${chatid}.log"
        ___x_cmd ensurefp "$logfp"
        exec >>"$logfp" 2>&1
    fi

    ___x_cmd_claw_run___agentrequest___checkunavailable || return 0

    ___x_cmd rmrf "$___X_CMD_CLAW_BOT_WS/HEARTBEAT_OK"
    ___x_cmd ensurefp "$___X_CMD_CLAW_BOT_HEARTBEAT/idle_count"
    printf "%s\n" "0" > "$___X_CMD_CLAW_BOT_HEARTBEAT/idle_count"

    local workspace_dir="$___X_CMD_CLAW_BOT_WS/${im}-${chatid}"
    local exitcode=0
    local reply_priority_prompt="### Reply Priority

Quick Q&A (you know the answer immediately): reply directly.

Tasks needing thinking/research/time: send a brief acknowledgement FIRST ('Got it, checking...' / 'On it.'), then continue working and send the real answer when ready.

Do not repeat what you already said. If there is nothing new to add, stay silent.

### Session Awareness

If you do not remember previous turns with this user, read AGENTS.md first to find where the conversation context is stored. Then read those context files to understand what you and the user discussed before, so you can continue without repeating yourself or making wrong assumptions.

### Duplicate Prevention

Before sending any reply, scan today's memory/YYYY-MM-DD.md entries. Look at the \`Sent\` field in each entry — it tells you what you have already told the user. If you have already sent a substantially similar answer to this question, do not send it again. Instead:
- If the user is re-asking: briefly reference your previous answer
- If there is nothing new to add: stay silent"

    # Initialize workspace from template if first run
    if [ ! -d "$workspace_dir" ]; then
        first_contact_prompt="$(___x_cmd_cmds cat "$___X_CMD_ROOT_MOD/claw/lib/data/prompt/first_contact.md" 2>/dev/null)"
        ___x_cmd cp -r "$___X_CMD_ROOT_MOD/claw/lib/data/workspace/msg" "$workspace_dir"
        ___x_cmd mkdirp "$workspace_dir/memory"
        ___x_cmd mkdirp "$workspace_dir/tmp"
    else
        # Ensure missing template files are present without overwriting existing ones
        local i
        for i in "$___X_CMD_ROOT_MOD/claw/lib/data/workspace/msg"/*; do
            [ -e "$i" ] || continue
            target="$workspace_dir/${i##*/}"
            [ -e "$target" ] || ___x_cmd cp -r "$i" "$target"
        done
        ___x_cmd mkdirp "$workspace_dir/memory"
        ___x_cmd mkdirp "$workspace_dir/tmp"
    fi

    if [ "$workspace_dir/AGENTS.md" -ot "$___X_CMD_ROOT_METADATA/version_sum" ]; then
        claw:info "Workspace template may have been updated, checking if structure optimization is needed"
        ___x_cmd_cmds touch "$workspace_dir/AGENTS.md"
        check_prompt="<workspace_check>
The workspace template has been updated. Use it as a reference to evaluate whether your current workspace structure needs improvements.

Reference template: $___X_CMD_ROOT_MOD/claw/lib/data/workspace/msg/
Current workspace:  $workspace_dir

Guidelines:
- This is a reference only — you decide what to adopt
- Compare structures and selectively apply beneficial changes
- Preserve existing user content and customizations
- Focus on structural gaps or organizational improvements
</workspace_check>"
    fi

    local latest_msg
    case "$im" in
        weixin)
            latest_msg="$(___x_cmd claw weixin recent-msg 2>/dev/null)" || {
                claw:debug "Failed to fetch recent message for weixin"
                latest_msg="[unavailable]"
            } ;;
        *)
            latest_msg="$(___x_cmd claw "$im" recent-msg "$chatid" 2>/dev/null)" || {
                claw:debug "Failed to fetch recent message for $im:$chatid"
                latest_msg="[unavailable]"
            } ;;
    esac

    log:sub:init -i "$im:$chatid" claw "Sending request to agent request"
    case "$im" in
        weixin)
            ___x_cmd agent request  \
                --timeout 1800 \
                --debug \
                --workspace "$workspace_dir"  \
                --reference-workspace "$___X_CMD_CLAW_AGENT_REFERENCE_WS" \
                "You have received a message from a user via WeChat.
${first_contact_prompt}

IMPORTANT: \`x\` is a POSIX shell function (not an external binary). Every new shell process (e.g., a fresh \`bash\` invocation) must load it first: \`. ~/.x-cmd.root/X\`. Without this step, \`x <mod>\` commands will fail with \"command not found\".

REPLY METHOD:
Use the command 'x weixin send' to reply:
- For help:        x weixin send -h
- For text:        x weixin send --text '<msg>'
  IMPORTANT: Do NOT use \\n for line breaks. The text \\n will be printed literally (two characters: backslash + n).
  CORRECT — press Enter for actual line breaks inside the quotes:
    '<msg>' becomes 'Line 1
    Line 2
    Line 3'
  WRONG — \\n appears as literal text in the output:
    'Line 1\\nLine 2\\nLine 3'
- For image/video: x weixin send --image <path>  or  x weixin send --video <path>

${reply_priority_prompt}

