# shellcheck shell=dash disable=2120

xrc:mod:lib date    epochminus  tz

___x_cmd_date___main(){
    [ $# -gt 0 ]    ||      set -- iso

    local op="$1";          shift
    case "$op" in
        -h|--help)          ___x_cmd help -m date   "$@" ;;
        str|varname|varname0|vlid|\
        iso|iso0|\
        timestamp|timestamp_|\
        iso2ts|iso2ts_|\
        counter|diff|epochminus|\
        tz2z|tz2z_|tz2colonz|tz2colonz_|\
        fromepoch|fromepoch_)
                            ___x_cmd_date_"$op"     "$@" ;;
        *)                  N=date M="Unknown subcmd -> $op" log:ret:64 ;;
    esac
}

# iso8601. TODO: zone is xx:yy , not xxyy. But BSD and busybox doesn't support %:z
___x_cmd_date_iso(){
    if [ $# -eq 0 ]; then
        ___x_cmd_cmds date +"%Y-%m-%dT%H:%M:%S%z"
    else
        ___x_cmd_date_util___ts2str "$1" "%Y-%m-%dT%H:%M:%S%z"
    fi
}

___x_cmd_date_iso0(){
    TZ=UTC0 ___x_cmd_date_iso
}

# rfc-3339 , TODO: zone is xx:yy , not xxyy. But BSD and busybox doesn't support %:z
___x_cmd_date_rfc(){
    if [ $# -eq 0 ]; then
        ___x_cmd_cmds date +"%Y-%m-%d %H:%M:%S%z"
    else
        ___x_cmd_date_util___ts2str "$1" "%Y-%m-%d %H:%M:%S%z"
    fi
}

# RFC 2822 / RFC 5322
___x_cmd_date_email(){
    if [ $# -eq 0 ]; then
        ___x_cmd_cmds date -R
    else
        ___x_cmd_date_util___ts2str "$1" "%a, %d %b %Y %H:%M:%S %z"
    fi
}

___x_cmd_date_str(){
    if [ $# -eq 0 ]; then
        ___x_cmd_cmds date +"%Y-%m-%d_%H:%M:%S%z"
    else
        ___x_cmd_date_util___ts2str "$1" "%Y-%m-%d_%H:%M:%S%z"
    fi
}

___x_cmd_date_localtime_tz_(){
    [ -z "$___X_CMD_DATE_LOCALTIME_TZ_" ]  ||  {
        x_="$___X_CMD_DATE_LOCALTIME_TZ_"
        return 0
    }

    x_=UTC0

    [ ! -f "$___X_CMD_ROOT_DATA/data/localtime_tz" ] || {
        if [ -f /etc/localtime ] && [ "$___X_CMD_ROOT_DATA/data/localtime_tz" -nt /etc/localtime ]; then
            read -r x_<"$___X_CMD_ROOT_DATA/data/localtime_tz"
            return 0
        fi
    }

    if [ -f /etc/localtime ]; then
        { read -r x_ && read -r x_; }</etc/localtime
    fi

    ___X_CMD_DATE_LOCALTIME_TZ_="$x_"
    printf "%s\n" "$x_">"$___X_CMD_DATE_LOCALTIME_TZ_"
}

___x_cmd_date_localtime_tz(){
    local x_
    ___x_cmd_date_localtime_tz_ || return $?
    printf "%s\n" "$x_"
}

___x_cmd_date_varname(){
    if [ $# -eq 0 ]; then
        ___x_cmd_cmds date +"%Y_%m_%d_%H_%M_%S%z" | tr '+' '_'
    else
        ___x_cmd_date_util___ts2str "$1" "%Y_%m_%d_%H_%M_%S%z" | tr '+' '_'
    fi
}

___x_cmd_date_varname0(){
    if [ $# -eq 0 ]; then
        TZ=UTC0 ___x_cmd_cmds date +"%Y_%m_%d_%H_%M_%S%z" | tr '+' '_'
    else
        TZ=UTC0 ___x_cmd_date_util___ts2str "$1" "%Y_%m_%d_%H_%M_%S%z" | tr '+' '_'
    fi
}

# TODO: Using UTC-00
# variable length ID
# In 22 century, just add 1 digit before the result. This function will be modified (possibly by AI) at that time if needed. Definitly I(L) want to live long enough to witness.
# In 100 centure, just add 2 digit before the result. Human will envolve in this way and definity don't need to worry about it.
___x_cmd_date_vlid(){
    if [ $# -eq 0 ]; then
        TZ=UTC0 ___x_cmd_cmds date +"%y%m%d_%H%M%S"
    else
        TZ=UTC0 ___x_cmd_date_util___ts2str "$1" "%y%m%d_%H%M%S"
    fi
}

___x_cmd_date_timestamp(){
    if [ "$#" -gt 0 ]; then
        ___x_cmd_date_iso2ts "$@"
    else
        ___x_cmd epoch get
    fi
}

___x_cmd_date_timestamp_(){
    if [ "$#" -gt 0 ]; then
        ___x_cmd_date_iso2ts_ "$@"
    else
        ___x_cmd epoch get_
    fi
}

___x_cmd_date_iso2ts_(){
    x_="$(___x_cmd_date_iso2ts "$@")"
}

# x date iso2ts '1990-3-25 0:0:0+8000'
___x_cmd_date_iso2ts(){
    if ! date -j 1>/dev/null 2>/dev/null; then
        ___x_cmd_date_iso2ts(){
            ___x_cmd_cmds date -d "$1" +%s
        }
    else
        ___x_cmd_date_iso2ts(){
            case "$1" in
                *-*-*\ *:*:*)
                    ___x_cmd_cmds date -j -f "%Y-%m-%d %H:%M:%S%z" "$1" +%s
                    ;;
                *-*-*)
                    ___x_cmd_cmds date -j -f "%Y-%m-%d" "$1" +%s
                    ;;
                *-*)
                    ___x_cmd_cmds date -j -f "%Y-%m" "$1" +%s
                    ;;
                *)
                    ___x_cmd is int "$1" || return 1
                    if [ "$1" -gt 9999 ]; then
                        ___x_cmd_cmds date -j -f "%Y%m%d" "$1" +%s
                    else
                        ___x_cmd_cmds date -j -f "%m%d" "$1" +%s
                    fi
                    ;;
            esac
        }
    fi

    ___x_cmd_date_iso2ts "$@"
}

___x_cmd_date_vlid2ts(){
    [ -n "$1" ] || return 1
    local vlid; vlid="$1"

    local date_part; date_part="${vlid%%_*}"
    local time_part; time_part="${vlid#*_}"

    local rest yy mm dd HH MM SS
    rest="${date_part#??}"; yy="${date_part%"$rest"}"
    rest="${date_part#????}"; mm="${date_part#??}"; mm="${mm%"$rest"}"
    rest="${date_part#??????}"; dd="${date_part#????}"; dd="${dd%"$rest"}"

    rest="${time_part#??}"; HH="${time_part%"$rest"}"
    rest="${time_part#????}"; MM="${time_part#??}"; MM="${MM%"$rest"}"
    rest="${time_part#??????}"; SS="${time_part#????}"; SS="${SS%"$rest"}"

    ___x_cmd_date_iso2ts "20${yy}-${mm}-${dd} ${HH}:${MM}:${SS}+0000"
}

___x_cmd_date_counter(){
    # local var="${name}"
    :
}


___x_cmd_date_diff_(){
    [ -n "$1" ] || return 1
    local a; a="$(___x_cmd_date_iso2ts "$1")"
    local b;
    if [ -z "$2" ]; then    b="$(___x_cmd_cmds date +%s)"
    else                    b="$(___x_cmd_date_iso2ts "$2")"
    fi

    if [ "$a" -gt "$b" ]; then      x_="$(( (a - b) / 60 / 60 / 24 ))"
    else                            x_="$(( (b - a) / 60 / 60 / 24 ))"
    fi
}

# L: 20230214: To answer the embarrass question like how may days since ...
___x_cmd_date_diff(){
    local x_
    ___x_cmd_date_diff_ "$@"
    printf "%s\n" "$x_"
}

___x_cmd_date_util___ts2str(){
    local ts="$1"
    local format="$2"

    case "$ts" in
        *.*)            ts="${ts%.*}" ;;
        ?????????????)  ts="${ts%???}" ;;
    esac

    local x_
    ___x_cmd os name_
    case "$x_" in
        darwin)  ___x_cmd_cmds date -j -f "%s" "$ts" +"$format" ;;
        *)       ___x_cmd_cmds date +"$format" -d @"$ts" ;;
    esac
}

___x_cmd_date_fromepoch(){
    local x_
    ___x_cmd_date_fromepoch_ "$@" || return $?
    printf "%s\n" "$x_"
}

___x_cmd_date_fromepoch_(){
    local fmt=iso
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)  ___x_cmd help -m date epochparser "$@" ; return 0 ;;
            # --fmt %Y-%m-%d %H:%M:%S.%:z'
            --rfc)      fmt=rfc ;           shift ;;
            # --fmt '%Y-%m-%dT%H:%M:%S.%:z'
            --iso)      fmt=iso ;           shift ;;
            --email)    fmt='%a, %d %b %Y %H:%M:%S %z' ; shift ;;
            --fmt)      fmt="$2" ;          shift 2 ;;
            +*)         fmt="${1#'+'}" ;    shift ;;
            --)         shift ;;
            -*)         N=date M="Unknown param -> $1" log:ret:64 ;;
            *)          break ;;
        esac
    done

    local epoch="$1"
    [ -n "$epoch" ] || {
        ___x_cmd epoch get_
        epoch="$x_"
    }

    local year month day hour minute second
    local epochday _tod _frac
    local _z _era _doe _yoe _doy _mp _wd _name

    # Strip sub-second portion (we don't expose ms in iso/rfc defaults).
    case "$epoch" in
        *.*)             epoch="${epoch%.*}" ;;
        ?????????????*)  epoch="${epoch%???}" ;;
        *)               ;;
    esac

    ___x_cmd_date_tz2offset_
    epoch=$((epoch + x_))

    if [ "$epoch" -lt 0 ] && [ "$((epoch % 86400))" -ne 0 ]; then
        epochday=$((epoch / 86400 - 1))
    else
        epochday=$((epoch / 86400))
    fi
    _tod=$((epoch - epochday * 86400))
    second=$((_tod % 60))
    minute=$((_tod / 60 % 60))
    hour=$((_tod / 3600))

    _z=$((epochday + 719468))
    if [ "$_z" -ge 0 ]; then
        _era=$((_z / 146097))
    else
        _era=$(( (_z - 146096) / 146097 ))
    fi
    _doe=$((_z - _era * 146097))
    _yoe=$(( (_doe - _doe/1460 + _doe/36524 - _doe/146096) / 365 ))
    year=$((_yoe + _era * 400))
    _doy=$((_doe - (365*_yoe + _yoe/4 - _yoe/100)))
    _mp=$(( (5*_doy + 2) / 153 ))
    day=$((_doy - (153*_mp + 2)/5 + 1))
    if [ "$_mp" -lt 10 ]; then
        month=$((_mp + 3))
    else
        month=$((_mp - 9))
    fi
    if [ "$month" -le 2 ]; then
        year=$((year + 1))
    fi

    case "$fmt" in
        rfc)
            ___x_cmd_date_tz2colonz_
            # Inline '%04d-%02d-%02d %02d:%02d:%02d%s' to skip the
            # $(printf ...) subshell that ___x_cmd printf_ would fork.
            # No ms — matches `x date rfc` (which uses date +%Y-%m-%d %H:%M:%S%z).
            while [ "${#year}"   -lt 4 ]; do year="0$year"   ; done
            case "$month"  in ?) month="0$month"  ;; esac
            case "$day"    in ?) day="0$day"    ;; esac
            case "$hour"   in ?) hour="0$hour"   ;; esac
            case "$minute" in ?) minute="0$minute" ;; esac
            case "$second" in ?) second="0$second" ;; esac
            x_="${year}-${month}-${day} ${hour}:${minute}:${second}${x_}"
            ;;
        iso)
            ___x_cmd_date_tz2colonz_
            # No ms — matches `x date iso` (date +%Y-%m-%dT%H:%M:%S%z).
            while [ "${#year}"   -lt 4 ]; do year="0$year"   ; done
            case "$month"  in ?) month="0$month"  ;; esac
            case "$day"    in ?) day="0$day"    ;; esac
            case "$hour"   in ?) hour="0$hour"   ;; esac
            case "$minute" in ?) minute="0$minute" ;; esac
            case "$second" in ?) second="0$second" ;; esac
            x_="${year}-${month}-${day}T${hour}:${minute}:${second}${x_}"
            ;;

        *)
            local ans=""
            while [ -n "$fmt" ]; do
                case "$fmt" in
                    '%Y'*)     while [ "${#year}"   -lt 4 ]; do year="0$year"   ; done
                               ans="${ans}$year"  ; fmt="${fmt#%Y}"  ;;
                    '%m'*)     case "$month"  in ?) month="0$month"  ;; esac
                               ans="${ans}$month" ; fmt="${fmt#%m}"  ;;
                    '%d'*)     case "$day"    in ?) day="0$day"    ;; esac
                               ans="${ans}$day"   ; fmt="${fmt#%d}"  ;;
                    '%H'*)     case "$hour"   in ?) hour="0$hour"   ;; esac
                               ans="${ans}$hour"  ; fmt="${fmt#%H}"  ;;
                    '%M'*)     case "$minute" in ?) minute="0$minute" ;; esac
                               ans="${ans}$minute" ; fmt="${fmt#%M}"  ;;
                    '%S'*)     case "$second" in ?) second="0$second" ;; esac
                               ans="${ans}$second" ; fmt="${fmt#%S}"  ;;

                    # Weekday / month names: compute lazily, only on demand.
                    '%a'*)     _wd=$(( ((epochday + 4) % 7 + 7) % 7 ))
                               case "$_wd" in
                                   0) _name="Sun" ;; 1) _name="Mon" ;; 2) _name="Tue" ;;
                                   3) _name="Wed" ;; 4) _name="Thu" ;; 5) _name="Fri" ;;
                                   6) _name="Sat" ;;
                               esac
                               ans="${ans}$_name" ; fmt="${fmt#%a}"  ;;
                    '%A'*)     _wd=$(( ((epochday + 4) % 7 + 7) % 7 ))
                               case "$_wd" in
                                   0) _name="Sunday"    ;; 1) _name="Monday"    ;;
                                   2) _name="Tuesday"   ;; 3) _name="Wednesday" ;;
                                   4) _name="Thursday"  ;; 5) _name="Friday"    ;;
                                   6) _name="Saturday"  ;;
                               esac
                               ans="${ans}$_name" ; fmt="${fmt#%A}"  ;;
                    '%b'*)     case "$month" in
                                   1) _name="Jan" ;; 2) _name="Feb" ;; 3) _name="Mar" ;;
                                   4) _name="Apr" ;; 5) _name="May" ;; 6) _name="Jun" ;;
                                   7) _name="Jul" ;; 8) _name="Aug" ;; 9) _name="Sep" ;;
                                   10) _name="Oct" ;; 11) _name="Nov" ;; 12) _name="Dec" ;;
                               esac
                               ans="${ans}$_name" ; fmt="${fmt#%b}"  ;;
                    '%B'*)     case "$month" in
                                   1) _name="January"   ;; 2) _name="February"  ;;
                                   3) _name="March"     ;; 4) _name="April"     ;;
                                   5) _name="May"       ;; 6) _name="June"      ;;
                                   7) _name="July"      ;; 8) _name="August"    ;;
                                   9) _name="September" ;; 10) _name="October"   ;;
                                   11) _name="November"  ;; 12) _name="December"  ;;
                               esac
                               ans="${ans}$_name" ; fmt="${fmt#%B}"  ;;

                    '%z'*)     ___x_cmd_date_tz2z_
                               ans="${ans}$x_" ; fmt="${fmt#%z}"  ;;
                    '%:z'*)    ___x_cmd_date_tz2colonz_
                               ans="${ans}$x_" ; fmt="${fmt#%:z}" ;;

                    '%%'*)     ans="${ans}%"      ; fmt="${fmt#%%}"  ;;

                    # Literal text up to the next % (preserve the % for next iter).
                    *'%'*)     ans="${ans}${fmt%%'%'*}"
                               fmt="${fmt#"${fmt%%'%'*}"}"
                               ;;
                    *)         ans="${ans}$fmt"  ; fmt="" ;;
                esac
            done
            x_="$ans"
            ;;
    esac
}
