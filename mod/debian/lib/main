# shellcheck shell=dash
___x_cmd log init   debian

___x_cmd_debian___main(){
    [ "$#" -gt 0 ]  || set -- sh

    local op="$1";      shift
    case "$op" in
        -h|--help)      ___x_cmd help -m debian         "$@" ;;

        img|image)      ___x_cmd_debian_image           "$@" ;;

        refit|ps|fz)    ___x_cmd_debian_"$op"           "$@" ;;

        init|cfg)       ___x_cmd_debian_cfg             "$@" ;;
        --|snap)        ___x_cmd_debian_snap            "$@" ;;

        :*)             ___x_cmd_debian_snapx "$op"     "$@" ;;

        *)              ___x_cmd_debian_snap "$op"      "$@" ;;
    esac
}

___x_cmd_debian_ps(){
    ___x_cmd docker ps --prefix "xde" "$@"
}

___x_cmd_debian_image(){
    ___X_CMD_DOCKER_IMAGE_PREFIX="xde-" \
        ___x_cmd docker image "$@"
}

___x_cmd_debian_fz(){
    ___X_CMD_DOCKER_PS_PREFIX="xde-"        \
    ___X_CMD_DOCKER_IMAGE_PREFIX="xde-"     \
        ___x_cmd docker fz  "$@"
}

___x_cmd_debian_snap(){
    ___x_cmd docker snap --imagetype debian "$@"
}

___x_cmd_debian_snapx(){
    ___X_CMD_DOCKER_IMGTYPE=debian  \
        ___x_cmd docker snapx --name "$@"
}

