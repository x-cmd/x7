
xrc:mod:lib     facl     get/linux       get/darwin

___x_cmd_facl_get(){
    local x_
    ___x_cmd os name_ || return

    case "$x_" in
        linux)      ___x_cmd_facl_get___linux    "$@" ;;
        darwin)     ___x_cmd_facl_get___darwin   "$@" ;;
        *)          N=facl M="Unsupported os -> $x_" log:ret:1 ;;
    esac
}
