

___x_cmd_humantime_tosec_(){
    local human="${1}"

    local num
    local decimal

    local day=0
    local day_decimal=0

    local hour=0
    local hour_decimal=0

    local minute=0
    local minute_decimal=0

    local second=0
    local second_decimal=0

    local num
    local IFS='dhms'
    for num in $human; do
        human="${human#"$num"}"
        case "$num" in
            *.*.*)
                N=humantime M="Invlaid number with two dot." log:ret:64 ;;
            *.*)
                decimal="${num#*.}"
                case "${#decimal}" in
                    8)  decimal="${decimal}0" ;;
                    7)  decimal="${decimal}00" ;;
                    6)  decimal="${decimal}000" ;;
                    5)  decimal="${decimal}0000" ;;
                    4)  decimal="${decimal}00000" ;;
                    3)  decimal="${decimal}000000" ;;
                    2)  decimal="${decimal}0000000" ;;
                    1)  decimal="${decimal}00000000" ;;
                    0)  decimal=0 ;;
                    *)  decimal=${decimal%"${decimal#????????}"} ;;
                esac
                num="${num%%.*}"
                ;;
            *)
                decimal=0
                ;;
        esac

        num="${num:-0}"
        case "$human" in
            d*)     day=$((     day     + num ))
                    day_decimal=$(( day_decimal + decimal ))
                    ;;
            h*)     hour=$((    hour    + num ))
                    hour_decimal=$(( hour_decimal + decimal ))
                    ;;
            m*)     minute=$((  minute  + num ))
                    minute_decimal=$(( minute_decimal + decimal ))
                    ;;
            s*)     second=$((  second  + num ))
                    second_decimal=$(( second_decimal + decimal ))
                    ;;
            *)      second=$((  second  + num ))
                    second_decimal=$(( second_decimal + decimal ))
                    ;;
        esac
        human="${human#?}"
    done

    x_=$(( ( ( day_decimal * 24 + hour_decimal ) * 60 + minute_decimal ) * 60 + second_decimal ))

    local rest=$(( x_ % 1000000000 ))
    x_=$(( ( ( ( day * 24 + hour ) * 60 + minute ) * 60 + second ) + x_ / 1000000000 ))

    local DOT="."
    if [ "$___X_CMD_HUMANTIME_UNIT" = ms ]; then
        DOT=""
    fi

    if [ $rest = 0 ]; then
        x_="${x_}${DOT}000"
    else
        case "${#rest}" in
            9)  x_="${x_}${DOT}${rest%??????}" ;;
            8)  x_="${x_}${DOT}0${rest%??????}" ;;
            7)  x_="${x_}${DOT}00${rest%??????}" ;;
            *)  x_="${x_}${DOT}000"
        esac
    fi
}

