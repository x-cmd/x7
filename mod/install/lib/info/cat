# shellcheck shell=dash disable=SC2034

___x_cmd_install_cat(){
    [ $# -gt 0 ]    ||  set -- --help

    local no_color=auto
    [ "$___X_CMD_INSTALL_ENABLE_COLOR" != 1 ] || no_color=""

    while [ $# -gt 0 ];     do
        case "$1" in
            -h|--help)      ___x_cmd help -m install cat "$@" ; return 0 ;;
            --color)        no_color="" ;;
            --nocolor)      no_color=1  ;;
            *)              break ;;
        esac
    done

    local x_

    local name="${1}"
    ___x_cmd os name_ ;     local ___X_CMD_OS_NAME_="$x_"
    ___x_cmd os arch_ ;     local ___X_CMD_OS_ARCH_="$x_"

    local release=""; local info="";  local wsl="";

    info="$( ___x_cmd os release )"
    release="${info%%
*}"
    wsl="${info%%-WSL?}"
    wsl="${info##"${wsl}"}"

    if [ "$no_color" = auto ]; then
        if { ___x_cmd_is_stdout2tty && ___x_cmd_runmode_allow_manual ; } ; then
            no_color=""
        else
            no_color=1
        fi
    fi

    ___x_cmd_install_get___info "${name}" | {
        ___x_cmd_cmds_awk \
            -v OS="$___X_CMD_OS_NAME_"  -v ARCH="$___X_CMD_OS_ARCH_"            \
            -v RELEASE="$release"       -v IS_RUN="${___X_CMD_INSTALL_IS_RUN}"  \
            -v wsl="$wsl" -v NAME="${name}"                     \
            -v NO_COLOR="$no_color"                             \
            -v ___X_CMD_LANG="${___X_CMD_LANG}"                 \
            -f "$___X_CMD_ROOT_MOD/awk/lib/core.awk"            \
            -f "$___X_CMD_ROOT_MOD/awk/lib/ui/ui.awk"           \
            -f "$___X_CMD_ROOT_MOD/awk/lib/sh.awk"              \
            -f "$___X_CMD_ROOT_MOD/awk/lib/j/json.awk"          \
            -f "$___X_CMD_ROOT_MOD/awk/lib/j/jiter.awk"         \
            -f "$___X_CMD_ROOT_MOD/install/lib/awk/util.awk"    \
            -f "$___X_CMD_ROOT_MOD/install/lib/awk/cat.awk"
    }
}
