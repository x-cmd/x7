# shellcheck shell=dash disable=SC2034

___x_cmd_install_ll(){
    [ $# -gt 0 ]    ||      set --  auto

    local fmt=auto
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m install ll "$@"; return 0 ;;
            --auto|--app|--tsv0|--raw)
                            fmt="${1#--}" ; shift ;;
            *)              N=install M="Unknown option -> $1" log:ret:64 ;;
        esac
    done
}

___x_cmd_install_ll___raw()(
    ___x_cmd_install_update___check || return $?
    ___x_cmd_install_ls___tsv | ___x_cmd tsv awk 'NR>1{ print $2"/"$1; }'
)

___x_cmd_install_ll___tsv0(){
    ___x_cmd_install_ll___raw
}

___x_cmd_install_ll___app(){
    ___X_CMD_PICK_SHBIN_CODE="xrc pkg install" \
        ___x_cmd_install___pickapp ___x_cmd_install_ll___raw "$@"
}

___x_cmd_install_ll___auto(){
    if ___x_cmd_is_stdout2tty && ___x_cmd_runmode_allow_manual; then
        ___x_cmd_install_ll___app   "$@"
    else
        ___x_cmd_install_ll___tsv0  "$@"
    fi
}
