# shellcheck shell=dash disable=2034
xrc ui

# x install jq yq sys/tq

___x_cmd_install_run(){
    [ $# -gt 0 ]    ||      set -- --help

    local mode=app
    while [ $# -gt 0 ]; do
        case "$1" in
            --auto)     mode=auto ; shift ;;
            *)          break ;;
        esac
    done

    local i; for i in "$@"; do
        ___x_cmd_install_run_one___"$mode" "$i" || return $?
    done
}

___x_cmd_install_run_one___auto(){
    case "$1" in
        winget/*|brew/*|apk/*|apt/*|pacman/*|dnf/*|yum/*|nix/*|\
        pixi/*|pkgx/*|xpkg/*|\
        curl/*|eget/*|\
        npm/*|pip/*|go/*|cargo/*)
                ___x_cmd install --withtool "${1%%/*}" "${1#*/}"    ;;
        x/*)    ___x_cmd install --withtool xpkg "${1#*/}"          ;;
        sys/*)  ___x_cmd install --sys      "${1#*/}"               ;;
        best/*) ___x_cmd install --best     "${1#*/}"               ;;

        */*)    N=install M="Unknown provider=${1%%/*} for software=${1#*/}" log:ret:64 ;;
        *)      ___x_cmd install --best     "${1#*/}" ;;
    esac
}

___x_cmd_install_run_one___app(){
    local software="$1"
    local x_=; ___x_cmd_install_run_one___app_ "$software" || return $?
    [ "$x_" != "Exit" ] || return 0

    ___x_cmd ui yesno "Whether to execute the following code: ${___X_CMD_UNSEENCHAR_NEWLINE}$(___x_cmd_ui bold cyan "$x_")" || return $?
    install:info --code "$x_" "Running the code"

    eval "$x_" || {
        local exitcode=$?
        install:error --cmd "$x_" --exitocd "$exitcode" "Fail to execute command"
        return 1
    }
}

___x_cmd_install_run___app_(){
    [ "$#" -gt 0 ]  ||      N=install M="Please provide sofotware" log:ret:64

    local software="$1" ;   shift 1
    local data; data="$( ___x_cmd_install___showcandidate "$software" )" || return $?

    ! ___x_cmd env --xinstall has "$software" || {
        data=" \"x env use ${software}\" ${data}"
    }

    [ -n "$data" ] || return 1
    local cmd="";
    eval ___x_cmd ui select id,cmd "\"Choose the code you want to execute:\"" "$data" || return $?
    [ -n "$cmd" ] || return 1
    x_="$cmd"
}

___x_cmd_install___showcandidate(){
    ___X_CMD_INSTALL_IS_RUN=1 ___x_cmd_install_cat "$1"
}

# The code below are unused.
___x_cmd_install_run___update_installer_(){
    local cmd="$1"
    x_=""
    case "$cmd" in
        apt)    if x hascmd apt; then
                    x_="x install run apt"
                else
                    x_="sudo apt update"
                fi
                ;;
        pacman) if x hascmd pacman; then
                    x_="x install run pacman"
                else
                    x_="sudo pacman -Sy"
                fi
                ;;
        brew)   if x hascmd brew; then
                    x_="x install run brew"
                fi
                ;;
        dnf)    x_="sudo dnf check-update" ;;
        yum)    x_="sudo yum check-update" ;;
    esac
}

___x_cmd_install___update_installer_(){
    local installer
    installer="$(x os release | head -n 1)"
    if [ "$installer" = "Ubuntu" ]; then
        x_="sudo apt update"
    elif [ "$installer" = "arch"  ]; then
        x_="sudo pacman -Sy"
    elif [ "$installer" = "fedora" ]; then

        if x hascmd dnf; then
            x_="sudo dnf check-update"
        else
            x_="sudo yum check-update"
        fi
    else
        x_="Update your installer"
    fi
}
