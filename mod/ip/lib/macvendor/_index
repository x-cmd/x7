# shellcheck disable=SC2016

xrc:mod:lib     ip      macvendor/db

___X_CMD_IP_MACVENDOR_CACHE="$___X_CMD_ROOT_CACHE/ip/macvendor"

___x_cmd_ip_macvendor(){
    case "$1" in
        -|-p|--pipe)        ___x_cmd_ip_macvendor___pipe;   return ;;
        --)                 shift ;;
    esac

    printf "%s\n" "$@" |    ___x_cmd_ip_macvendor___pipe
}

___x_cmd_ip_macvendor___pipe(){
    local data; data="$( ___x_cmd_ip_macvaddr_normal )" || return

    ___x_cmd_pipevar data   ___x_cmd_ip_macvendor_cache_pipe
    ___x_cmd_pipevar data   ___x_cmd_ip_macvendor_db_get_pipe
}

___x_cmd_ip_macvaddr_normal(){
    ___x_cmd_cmds awk '
    {
        l = split($0, arr, ":")
        ret = ""
        for (i=1; i<=l; ++i) {
            ret = ret ( ( 1 == length(arr[i]) ) ? "0" : "" ) arr[i]
        }

        gsub("^:", "", ret)
        print ret
    }
    '
}
