


___x_cmd_ip_macvendor_db_exist(){
    local mac="$1"

    local mac6="${mac%"${mac#??????}"}"
    local mac7="${mac%"${mac#???????}"}"
    local mac9="${mac%"${mac#?????????}"}"

    [ -f "${___X_CMD_IP_MACVENDOR_CACHE}/$mac6" ] || \
    [ -f "${___X_CMD_IP_MACVENDOR_CACHE}/$mac7" ] || \
    [ -f "${___X_CMD_IP_MACVENDOR_CACHE}/$mac9" ]
}

___x_cmd_ip_macvendor_db_get_(){
    local mac="$1"

    local mac6="${mac%"${mac#??????}"}"
    local mac7="${mac%"${mac#???????}"}"
    local mac9="${mac%"${mac#?????????}"}"

    local file=""
    while read -r file; do
        file="${___X_CMD_IP_MACVENDOR_CACHE}/$mac6"
        [ -f "$file" ] || continue
        read -r x_ <"${file}"
        return 0
    done <<A
$mac6
$mac7
$mac9
A

    return 1

}

___x_cmd_ip_macvendor_db_get(){
    local mac="$1"
    local none="${2:-None}"

    local x_=""
    ___x_cmd_ip_macvendor_db_get_ "$mac" || printf "%s\n" "$none"
    printf "%s\n" "$x_"
}

___x_cmd_ip_macvendor_db_get_pipe(){
    local macaddr=""
    while read -r macaddr; do
        ___x_cmd_ip_macvendor_db_get "$macaddr" "None"
    done
}


___x_cmd_ip_macvendor_db_putfrompipe(){
    ___x_cmd_mkdirp "$___X_CMD_IP_MACVENDOR_CACHE"

    ___x_cmd_cmds awk -v dir="${___X_CMD_IP_MACVENDOR_CACHE}" -v FS="\t" '
    {
        if ($2 != "") {
            printf("%s\n", $3)>(dir "/" $2)
        }
    }
    '

}

___x_cmd_ip_macvendor_cache_pipe(){
    local query=""
    local macaddr="";
    while read -r macaddr; do
        [ -n "$macaddr" ] || continue
        ___x_cmd_ip_macvendor_db_exist "${macaddr}" || query="$query,$macaddr"
    done

    [ -z "$query" ] || {
        ip:debug "query -> $query"
        ___x_cmd curl -s --fail "https://ipmac.hub.x-cmd.com/query/macvendor/mac/${query#,}" 2>/dev/null | \
            ___x_cmd_ip_macvendor_db_putfrompipe || return
    }
}
