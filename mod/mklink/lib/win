# shellcheck shell=dash
___x_cmd_mklink___win(){
    [ "$#" -gt 0 ] ||   set -- --help
    local lntypt="/J"
    local op="$1"; shift
    case "$op" in
        -h|--help)          ___x_cmd help -m mklink; return 0     ;;
        -d|/d)              lntypt="/D" ;;
        --hard|/h)          lntypt="/H" ;;
        -j|--junction)      lntypt="/J" ;;
        *)                  ___x_cmd_mklink___run "$op" "$@" ; return ;;
    esac

    local target="$1"
    local link="$2"
    local x_; ___x_cmd pwsh path linux_to_win_ "$target"
    local targetfp="${x_#*":"}"

    ___x_cmd_mklink___run "/${lntypt}" "$link" "$targetfp"
}
