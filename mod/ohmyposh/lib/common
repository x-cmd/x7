# shellcheck shell=dash disable=2034

___X_CMD_OHMYPOSH_CONFIG_USE_FP="$___X_CMD_ROOT_DATA/ohmyposh/use"
___x_cmd_ohmyposh_use(){
    local X_help_cmd; X_help_cmd='___x_cmd help -m ohmyposh use' help:arg-null:parse
    local name="$1"
    ___x_cmd_ohmyposh___applyfile0
    ___x_cmd_ohmyposh_load___inner || return
    ___x_cmd_ohmyposh___applyfile "$name" || return

    ___x_cmd ensurefp "$___X_CMD_OHMYPOSH_CONFIG_USE_FP"
    printf "%s\n" "$name" > "$___X_CMD_OHMYPOSH_CONFIG_USE_FP"
}

___x_cmd_ohmyposh_unuse(){
    local X_help_cmd; X_help_cmd='___x_cmd help -m ohmyposh unuse' help:arg:parse
    ___x_cmd_ohmyposh___applyfile0
    ___x_cmd rmrf "$___X_CMD_OHMYPOSH_CONFIG_USE_FP"
}

___x_cmd_ohmyposh___check_use(){
    [ -f "$___X_CMD_OHMYPOSH_CONFIG_USE_FP" ] || return 0
    local name=; read -r name < "$___X_CMD_OHMYPOSH_CONFIG_USE_FP"
    [ -z "$name" ] || ___x_cmd_ohmyposh___applyfile "$name"
}

___x_cmd_ohmyposh_try(){
    local X_help_cmd; X_help_cmd='___x_cmd help -m ohmyposh try' help:arg-null:parse
    ___x_cmd_ohmyposh___applyfile0
    ___x_cmd_ohmyposh_load___inner || return
    ___x_cmd_ohmyposh___applyfile "$1" || return
    export ___X_CMD_OHMYPOSH_CONFIG_TRY_TAKEOVER=1
}

___x_cmd_ohmyposh_untry(){
    local X_help_cmd; X_help_cmd='___x_cmd help -m ohmyposh untry' help:arg:parse
    ___x_cmd_ohmyposh___applyfile0
    ___x_cmd_ohmyposh___check_use
}

___x_cmd_ohmyposh___applyfile(){
    local name="$1"
    local x_=; ___x_cmd_ohmyposh_which_ "$name" || return
    export POSH_THEME="$x_"
}

___x_cmd_ohmyposh___applyfile0(){
    unset ___X_CMD_OHMYPOSH_CONFIG_TRY_TAKEOVER
    unset POSH_THEME
}
