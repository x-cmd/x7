
___x_cmd_ps_tree(){
    [ "$#" -gt 0 ] ||       set  --     --ls

    local fmt=tsv

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)          ___x_cmd help -m kill;      return ;;
            --tsv|--csv|--pid)  fmt="${1#--}" ; shift ;;
            *)                  break ;;
        esac
    done

    local target_pid="$1"
    [ -n "$target_pid" ] || return 0


    # TODO: using BFS to optimize
    ___x_cmd_cmds ps -ax -o pid=,ppid= 2>/dev/null | ___x_cmd_cmds awk -v root="$target_pid" '
        {
            parent[$1] = $2;
            all_pids[count++] = $1;
        }
        END {
            visited[root] = 1;
            changed = 1;
            while (changed) {
                changed = 0;
                for (i=0; i<count; i++) {
                    p = all_pids[i];
                    if (!visited[p] && visited[parent[p]]) {
                        visited[p] = 1;
                        changed = 1;
                        printf "%s ", p;
                    }
                }
            }
            printf "%s", root;
        }
    '

}
