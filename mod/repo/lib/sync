
___x_cmd_repo_sync(){
    [ $# -gt 0 ]    ||  set -- --help

    local n=1
    local pipe=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -n)             n="$2" ; arg:2:shift ;;
            --pipe)         pipe=1 ; shift ;;
            --)             shift ; break ;;
            *)              break ;;
        esac
    done

    if [ "$n" -le 1 ]; then
        if [ -n "$pipe" ]; then
            local line
            while read -r line; do
                ___x_cmd_repo_sync_work_fromline "$line"
            done
        else
            local repo_sync_arg=""

            while [ $# -gt 0 ]; do
                case "$1" in
                    --)     eval "___x_cmd_repo_sync_work $repo_sync_arg" ; repo_sync_arg=""; shift ;;
                    *)      arg:add repo_sync_arg "$1" ; shift ;;
                esac
            done

            [ -z "$repo_sync_arg" ] || eval "___x_cmd_repo_sync_work $repo_sync_arg"
        fi
        return $?
    fi

    ___x_cmd job failfast init "$n"

    {
        if [ -n "$pipe" ]; then
            local line
            while read -r line; do
                ___x_cmd job failfast put ___x_cmd_repo_sync_work_fromline "$line"
            done
        else
            local repo_sync_arg=""

            while [ $# -gt 0 ]; do
                case "$1" in
                    --)     eval "___x_cmd job failfast put ___x_cmd_repo_sync_work $repo_sync_arg" ; repo_sync_arg=""; shift ;;
                    *)      arg:add repo_sync_arg "$1" ; shift ;;
                esac
            done
            [ -z "$repo_sync_arg" ] || eval "___x_cmd job failfast put ___x_cmd_repo_sync_work $repo_sync_arg"
        fi
    } | {
        ___x_cmd job failfast fini
    }
}

___x_cmd_repo_sync_work(){
    local PWD
    local OLDPWD
    local x_

    local source="$1" ; shift
    ___x_cmd repo prepare "$source"
    ___x_cmd repo which_ "$source"
    ___x_cmd_inner_cd "$x_"

    ___x_cmd git all push "$@"
}

___x_cmd_repo_sync_work_fromline(){
    local x_
    ___x_cmd line from_ "$1"; set -- ""; shift

    local line
    while read -r line; do
        [ -n "$line" ] || continue
        set -- "$@" "$line"
    done <<A
$x_
A
    ___x_cmd_repo_sync_work "$@"
}

