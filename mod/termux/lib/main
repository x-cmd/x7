# shellcheck shell=dash

___x_cmd log init termux

xrc:mod:lib     termux      \
                shortcut        prep            \
                torch   wifi    cpu     sshd    \
                pkg/_index

___x_cmd_termux___main(){
    [ "$#" -gt 0 ] ||   set -- info

    local op="$1"; shift
    case "$op" in
        --prep|prep)    ___x_cmd_termux_prep        "$@" ;;

        v|vibratre)     ___x_cmd_termux_vibrate     "$@" ;;

        o|open)         ___x_cmd_termux_open        "$@" ;;

        b|browse|openurl)
                        ___x_cmd_termux_openurl     "$@" ;;

        cp)             ___x_cmd_termux_cp          "$@" ;;
        pa|paste)       ___x_cmd_termux_paste       "$@" ;;

        noti|notification)
                        ___x_cmd_termux_noti        "$@" ;;

        cam)            ___x_cmd_termux_cam         "$@" ;;
        mp)             ___x_cmd_termux_mp          "$@" ;;
        tele)           ___x_cmd_termux_tele        "$@" ;;
        ir)             ___x_cmd_termux_ir          "$@" ;;

        toast|dialog|\
        sms|contact|call|\
        wake|\
        wifi|torch|battery|\
        cpu|\
        say|info|tts|api|\
        shortcut|pkg)
                        ___x_cmd_termux_"$op"       "$@" ;;

        st|storage)     ___x_cmd_termux_storage     "$@" ;;


        mic|microphone) ___x_cmd_termux_microphone  "$@" ;;
    esac
}

___x_cmd_termux_run(){
    command docker run --name termux -it "$@" termux/termux-docker
}

___x_cmd_termux_prep(){
    case "$1" in
        -h|--help)      ___x_cmd help -m termux prep    "$@"; return ;;
    esac

    # Consider install ssh
    ___x_cmd_cmds apk install -y termux-api
}

___x_cmd_termux_info(){
    case "$1" in
        -h|--help)      ___x_cmd help -m termux browse  "$@"; return ;;
    esac
    ___x_cmd_cmds termux-info       "$@"
}

___x_cmd_termux_vibrate(){
    case "$1" in
        -h|--help)      ___x_cmd help -m termux vibrate  "$@"; return ;;
    esac
    ___x_cmd_cmds termux-vibrate    "$@"
}

___x_cmd_termux_browse(){
    case "$1" in
        -h|--help)      ___x_cmd help -m termux browse  "$@"; return ;;
    esac
    ___x_cmd_cmds termux-open-url   "$@"
}

___x_cmd_termux_open(){
    case "$1" in
        -h|--help)      ___x_cmd help -m termux open    "$@"; return ;;
    esac
    ___x_cmd_cmds termux-open       "$@"
}

