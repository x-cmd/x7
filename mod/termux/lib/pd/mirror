

___x_cmd_termux_pd_mirror(){
    local op="$1";      shift
    case "$op" in
        -h|--help)      ___x_cmd_help -m termux pd mirror "$@" ;;

        use|unuse|isset)
                        ___x_cmd_termux_pd_mirror_"$op" "$@" ;;

        *)              N=termux M="Unknown subcmd -> $op" log:ret:64 ;;
    esac
}

