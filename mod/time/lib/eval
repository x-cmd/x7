

# x time --eval -c 10000 'echo world'

___x_cmd_time_eval(){
    local count=""

    local offsetcmd="echo hi;"

    arg:init time
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)  ___x_cmd help -m time --eval "$@" ; return 0 ;;
            -c)         count="$2"      ;   arg:2:shift ;;
            -o)         offsetcmd="$2"  ;   arg:2:shift ;;
            *)          break
        esac
    done

    local str="$offsetcmd $1"

    time:info "Calculating offset"
    ___x_cmd_time_eval_offset_ "$offsetcmd";     local offset="$x_"
    time:info "offset -> $offset"

    local begin=""
    local end=""

    local x_=""
    ___x_cmd_time_eval___once_ "$str"; once="$x_"

    time:info "First run time cost -> $once"

    if [ -z "$count" ]; then
        ! ___x_cmd_time_eq0 "$once" || N=time M="Fail to estimate the time cost. Please provide -c <count>" log:ret:1
        ___x_cmd_time_div 10000 "$once";    count="$x_"
        [ "${count}" -gt 5 ]        || count=5
        [ "${count}" -le 100000 ]   || count=100000     # The eval string ...
    fi

    time:info "Running the command in [count=$count] times -> $str"

    ___x_cmd_time_mul_ "$once" "$count"
    time:info "Estimated run time -> $x_ ms"

    {
        ___x_cmd_epoch_real_;      begin="$x_"

        local i=2; while [ $i -le "$count" ]; do
            eval "$str"
            i=$(( i+1 ))
        done # 1>/dev/null 2>/dev/null

        ___x_cmd_epoch_real_;      end="$x_"

    } 1>/dev/null 2>/dev/null

    time:info "Estimated run time -> $begin $end"

    ___x_cmd_time_caldiff_  "$begin"    "$end" ;        local sum="$x_"
    ___x_cmd_time_calavg_   "$sum"      "$count" ;      local avg="$x_"
    ___x_cmd_time_minus_    "$avg"      "$offset";      local avg1="$x_"

    # using awk to generate report for floating arithmetics ...
    time:info \
        --count             "$count"    \
        --sum               "$sum"      \
        --avg           "    $avg"      \
        --avg-off           "$avg1"     \
        "Report ( unit: ms )"
}

___x_cmd_time_eval_offset_(){
    local offsetcmd="$1"

    local count=10000

    x_=""

    local begin=""
    local end=""
    ___x_cmd_epoch_real_;      begin="$x_"

    local i=1; while [ $i -le $count ]; do
        eval "$offsetcmd"
        i=$(( i+1 ))
    done 1>/dev/null 2>/dev/null

    ___x_cmd_epoch_real_;      end="$x_"
    ___x_cmd_time_caldiff_  "$begin"    "$end"
    ___x_cmd_time_calavg_   "$x_"       "$count"
}


___x_cmd_time___evalstr_(){
    local count="$1"
    local str="$2"

    x_=""
    local i=1;
    while [ "$i" -le "$count" ]; do
        x_="${x_}${___X_CMD_UNSEENCHAR_NEWLINE}$str"
        i=$((i+1))
    done
}


___x_cmd_time_eval___once_(){
    local cmd="$1"
    {
        ___x_cmd_epoch_real_;      local begin="$x_"
        eval "$cmd"
        ___x_cmd_epoch_real_;      local end="$x_"
    } 1>/dev/null 2>/dev/null

    ___x_cmd_time_caldiff_ "$begin" "$end"
}
