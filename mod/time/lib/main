# shellcheck shell=dash

___x_cmd log init time

xrc epoch

xrc:mod:lib     time        util stress cmp

___x_cmd_time___main(){
    [ "$#" -gt 0 ] ||   set -- --help

    local op="$1";      shift
    case "$op" in
        -h|--help)      ___x_cmd help -m time       "$@" ;      return 0 ;;

        stress|log|cmp|\
        getms|getms_|getreal|getreal_|getrealms|getrealms_)
                        ___x_cmd_time_"${op}"       "$@" ;;

        --)             ___x_cmd_time_getreal   "$@" ;;
        -*)             ___x_cmd_time_stress    "$op" "$@" ;;
        *)              ___x_cmd_time_getreal   "$op" "$@" ;;
    esac
}

___x_cmd_time_log(){
    arg:init time
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)          ___x_cmd help -m time log "$@" ; return 0 ;;
            *)                  break
        esac
    done

    # Use temp files to capture times (avoids subshell variable capture issues)
    local times_before_file="${TMPDIR:-/tmp}/time_log_before.$$"
    local times_after_file="${TMPDIR:-/tmp}/time_log_after.$$"

    # Wall-clock time
    local x_=""
    ___x_cmd_epoch_ms_; local begin="$x_"

    # CPU time before (child processes only)
    times > "$times_before_file"

    # Execute command
    "$@"
    local ret=$?

    # CPU time after
    times > "$times_after_file"

    # Wall-clock after
    ___x_cmd_epoch_ms_; local end="$x_"
    local wall=$(( end - begin ))

    # Parse times and calculate deltas
    # times output (2 lines, 2 fields each):
    #   Line 1: shell_user shell_sys
    #   Line 2: child_user child_sys
    # Before and after are concatenated: 4 lines total
    # Format: NmF.US for dash, NmF.Fs for zsh (variable decimals)
    local cpu_info
    if [ -f "$times_before_file" ] && [ -f "$times_after_file" ]; then
        cpu_info="$(cat "$times_before_file" "$times_after_file" | ___x_cmd_cmds awk '{
            for(i=1;i<=2;i++){
                split($i, a, "m")
                gsub(/s/, "", a[2])
                split(a[2], b, ".")
                # Normalize decimal part to 6 digits
                dec_len = length(b[2])
                dec_part = b[2] + 0
                if(dec_len < 6){
                    dec_part = dec_part * (10^(6 - dec_len))
                } else if(dec_len > 6){
                    dec_part = substr(b[2], 1, 6) + 0
                }
                val = a[1] * 60 + b[1] + dec_part / 1000000

                if(NR==1){
                    if(i==1) before_shell_user=val
                    else before_shell_sys=val
                }
                if(NR==2){
                    if(i==1) before_child_user=val
                    else before_child_sys=val
                }
                if(NR==3){
                    if(i==1) after_shell_user=val
                    else after_shell_sys=val
                }
                if(NR==4){
                    if(i==1) after_child_user=val
                    else after_child_sys=val
                }
            }
        }
        END{
            child_user=after_child_user-before_child_user
            child_sys=after_child_sys-before_child_sys
            shell_user=after_shell_user-before_shell_user
            shell_sys=after_shell_sys-before_shell_sys
            printf "%.3f:%.3f:%.3f:%.3f", child_user, child_sys, shell_user, shell_sys
        }')"
    else
        cpu_info="0.000:0.000:0.000:0.000"
    fi

    # Cleanup
    rm -f "$times_before_file" "$times_after_file"

    printf "real:%dms\n" "$wall"
    # cpu_info format: child_user:child_sys:shell_user:shell_sys
    # Parse it for proper display
    local child_user child_sys shell_user shell_sys rest
    child_user="${cpu_info%%:*}"
    rest="${cpu_info#*:}"
    child_sys="${rest%%:*}"
    rest="${rest#*:}"
    shell_user="${rest%%:*}"
    shell_sys="${rest##*:}"
    printf "real:%dms  user:%.3fs  sys:%.3fs  child_user:%.3fs  child_sys:%.3fs\n" \
        "$wall" "$child_user" "$child_sys" "$shell_user" "$shell_sys"
    return $ret
}

___x_cmd_time_getms_(){
    {
        ___x_cmd_epoch_ms_;      local begin="$x_"
        "$@"
        ___x_cmd_epoch_ms_

        x_=$(( x_ - begin ))
    } >/dev/null 2>/dev/null
}

___x_cmd_time_getms(){
    local x_
    ___x_cmd_time_getms_ "$@"
    printf "%s\n" "$x_"
}


___x_cmd_time_getrealms(){
    {
        local x_
        ___x_cmd_epoch_real_; local begin="$x_"
        "$@" >/dev/null 2>/dev/null
        ___x_cmd_epoch_real_; local end="$x_"
    } >/dev/null 2>/dev/null

    ___x_cmd_cmds awk -v end="$end" -v begin="$begin" 'BEGIN{  printf("%-10.3f", (end-begin) * 1000 ) ; }'
}

___x_cmd_time_getrealms_(){
    x_="$(___x_cmd_time_getrealms "$@")"
}

___x_cmd_time_getreal(){
    {
        local x_
        ___x_cmd_epoch_real_; local begin="$x_"
        "$@"
        ___x_cmd_epoch_real_; local end="$x_"
    } >/dev/null 2>/dev/null

    ___x_cmd_cmds awk -v end="$end" -v begin="$begin" 'BEGIN{  printf("%-10.3f", (end-begin) ) ; }'
}

___x_cmd_time_getreal_(){
    x_="$(___x_cmd_time_getreal "$@")"
}

