    local count="$1" ;  shift
    local x_
    (
        ___x_cmd_epoch_real_; printf "%s\n" "$x_"

        local i=1
        while [ "$i" -le "$count" ]; do
            "$@"
            ___x_cmd_epoch_real_; printf "%s\n" "$x_"
            i=$((i+1))
