
___x_cmd_time_stress(){
    arg:init time

    local count=""
    local outputmode=""
    local testmode=auto

    local budget_ms=""    # 5 seconds

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)  ___x_cmd help -m time --stress "$@" ; return 0 ;;
            -c)         count="$2";         arg:2:shift ;;
            --)         shift ; break ;;
            --avg)      outputmode=avg  ;   shift ;;
            --csv)      outputmode=csv  ;   shift ;;
            --csv0)     outputmode=csv0 ;   shift ;;
            --tsv)      outputmode=tsv  ;   shift ;;
            --tsv0)     outputmode=tsv0 ;   shift ;;
            --tty)      outputmode=tty  ;   shift ;;
            --yml)      outputmode=yml  ;   shift ;;

            -b|--budget)
                        budget_ms="$(( $2 * 1000 ))" ;
                                            arg:2:shift ;;

            --batch10)  testmode=batch10 ;  shift ;;
            --normal)   testmode=normal  ;  shift ;;

            --*)        N=time M="Unknown options -> $1" log:ret:64 ;;

            *)          break
        esac
    done

    # Default: csv app if tty, tsv if pipe
    if [ -z "$outputmode" ]; then
        if ___x_cmd_is_stdout2tty && ___x_cmd_runmode_allow_manual ; then
            outputmode=app
        else
            outputmode=tsv
        fi
    fi

    local x_

    if [ -z "$count" ]; then
        budget_ms="${budget_ms:-5000}"
        ___x_cmd_time_getms_ "$@" >/dev/null 2>/dev/null
        if [ "$x_" -eq 0 ]; then x_=1; fi

        count="$(( budget_ms / x_ ))"
        if [ "$count" -gt 10 ]; then
            count="$((count / 10 * 10))"
        fi
        time:debug --count "$count" --budge "$(( budget_ms / 1000 ))" "Automatically decide."
    fi

    local offset_avg0
    offset_avg0="$( ___x_cmd_time_stress___main_est avg 1000 printf "%s")"

    local offset_avg1
    offset_avg1="$( ___x_cmd_time_stress___main_noredirect avg 1000 printf "%s")"

    local offset_avg2
    offset_avg2="$( ___x_cmd_time_stress___main avg 1000 printf "%s")"

    time:debug \
        --offset0 "$offset_avg0" --offset1 "$offset_avg1" --offset2 "$offset_avg2" \
        "Calibration"

    local awk_output="$outputmode"
    if [ "$outputmode" = "app" ]; then
        awk_output=csv
    fi

    local result_cmd
    if [ "$testmode" = batch10 ]; then
        result_cmd=___x_cmd_time_stress___main1run10
    else
        local tryrun_result
        local tryrun_count=10
        if [ "$count" -lt "$tryrun_count" ]; then   tryrun_count=$count;    fi
        tryrun_result="$( ___x_cmd_time_stress___main avg "$tryrun_count" "$@")"

        case "$tryrun_result" in
            # 0.0*)   result_cmd=___x_cmd_time_stress___main1run100 ;;
            0.*)    result_cmd=___x_cmd_time_stress___main1run10 ;;
            *)      result_cmd=___x_cmd_time_stress___main1run ;;
        esac
    fi

    if [ "$outputmode" = "app" ]; then
        "$result_cmd" "$awk_output" "$count" "$@" | ___x_cmd csv app
    else
        "$result_cmd" "$awk_output" "$count" "$@"
    fi
}

___x_cmd_time_stress___main1run(){
    local outputmode="$1" ; local count="$2" ;  shift 2
    ___X_CMD_TIME_OFFSET0="$offset_avg0" \
    ___X_CMD_TIME_OFFSET1="$offset_avg1" \
    ___X_CMD_TIME_OFFSET2="$offset_avg2" \
        ___x_cmd_time_stress___main "$outputmode" "$count" "$@"
    ___x_cmd_time_stress___main_cpu_avg "$count" "$@"
}

___x_cmd_time_stress___main1run10(){
    local outputmode="$1" ; local count="$2" ;  shift 2
    ___X_CMD_TIME_OFFSET0="$offset_avg0" \
    ___X_CMD_TIME_OFFSET1="$offset_avg1" \
    ___X_CMD_TIME_OFFSET2="$offset_avg2" \
        ___x_cmd_time_stress___main10 "$outputmode" "$count" "$@"
    ___x_cmd_time_stress___main_cpu_avg "$count" "$@"
}

___x_cmd_time_stress___main(){
    local outputmode="$1" ; local count="$2" ;  shift 2
    local x_
    (
        ___x_cmd_epoch_real_; printf "%s\n" "$x_"

        local i=1
        while [ "$i" -le "$count" ]; do
            "$@" 1>/dev/null 2>/dev/null
            ___x_cmd_epoch_real_; printf "%s\n" "$x_"
            i=$((i+1))
        done
    ) | {
        ___x_cmd_cmds awk -v "output=$outputmode" -f "${___X_CMD_ROOT_MOD}/time/lib/report.awk"
    }
}

___x_cmd_time_stress___main_cpu_avg(){
    # Compute CPU time averages for the command
    local count="$1" ; shift
    local times_before_file="${TMPDIR:-/tmp}/time_cpu_before.$$"
    local times_after_file="${TMPDIR:-/tmp}/time_cpu_after.$$"
    local child_user_sum=0 child_sys_sum=0 shell_user_sum=0 shell_sys_sum=0

    times >/dev/null 2>&1  # warm up times
    times > "$times_before_file"

    local i=1
    while [ "$i" -le "$count" ]; do
        "$@" 1>/dev/null 2>/dev/null
        times > "$times_after_file"

        # Parse CPU times and accumulate
        local result
        result="$(cat "$times_before_file" "$times_after_file" | ___x_cmd_cmds awk '{
            for(i=1;i<=2;i++){
                split($i, a, "m")
                gsub(/s/, "", a[2])
                split(a[2], b, ".")
                dec_len = length(b[2])
                dec_part = b[2] + 0
                if(dec_len < 6){
                    dec_part = dec_part * (10^(6 - dec_len))
                } else if(dec_len > 6){
                    dec_part = substr(b[2], 1, 6) + 0
                }
                val = a[1] * 60 + b[1] + dec_part / 1000000
                if(NR==1){
                    if(i==1) before_shell_user=val
                    else before_shell_sys=val
                }
                if(NR==2){
                    if(i==1) before_child_user=val
                    else before_child_sys=val
                }
                if(NR==3){
                    if(i==1) after_shell_user=val
                    else after_shell_sys=val
                }
                if(NR==4){
                    if(i==1) after_child_user=val
                    else after_child_sys=val
                }
            }
        }
        END{
            printf "%.6f:%.6f:%.6f:%.6f\n", after_child_user-before_child_user, after_child_sys-before_child_sys, after_shell_user-before_shell_user, after_shell_sys-before_shell_sys
        }')"

        # Move after to before for next iteration
        cat "$times_after_file" > "$times_before_file"

        # Accumulate using awk for precision
        child_user_sum="$(awk "BEGIN{print $child_user_sum + ${result%%:*}}")"
        result="${result#*:}"
        child_sys_sum="$(awk "BEGIN{print $child_sys_sum + ${result%%:*}}")"
        result="${result#*:}"
        shell_user_sum="$(awk "BEGIN{print $shell_user_sum + ${result%%:*}}")"
        result="${result#*:}"
        shell_sys_sum="$(awk "BEGIN{print $shell_sys_sum + ${result##*:}}")"

        i=$((i+1))
    done

    rm -f "$times_before_file" "$times_after_file"

    # Output averages
    awk -v cu="$child_user_sum" -v cs="$child_sys_sum" -v su="$shell_user_sum" -v ss="$shell_sys_sum" -v c="$count" 'BEGIN{
        printf "child_user_avg:%.3f  child_sys_avg:%.3f  shell_user_avg:%.3f  shell_sys_avg:%.3f\n", cu/c, cs/c, su/c, ss/c
    }'
}

___x_cmd_time_stress___main_est(){
    local outputmode="$1" ; local count="$2" ;  shift 2
    local x_
    (
        ___x_cmd_epoch_real_; printf "%s\n" "$x_"

        local i=1
        while [ "$i" -le "$count" ]; do
            ___x_cmd_epoch_real_; printf "%s\n" "$x_"
            i=$((i+1))
        done
    ) | {
        ___x_cmd_cmds awk -v "output=$outputmode" -f "${___X_CMD_ROOT_MOD}/time/lib/report.awk"
    }
}

___x_cmd_time_stress___main_noredirect(){
    local outputmode="$1" ; local count="$2" ;  shift 2
    local x_
    (
        ___x_cmd_epoch_real_; printf "%s\n" "$x_"

        local i=1
        while [ "$i" -le "$count" ]; do
            "$@"
            ___x_cmd_epoch_real_; printf "%s\n" "$x_"
            i=$((i+1))
        done
    ) | {
        ___x_cmd_cmds awk -v "output=$outputmode" -f "${___X_CMD_ROOT_MOD}/time/lib/report.awk"
    }
}


___x_cmd_time_stress___main10(){
    local outputmode="$1" ; local count="$2" ;  shift 2
    local x_
    (
        ___x_cmd_epoch_real_; printf "%s\n" "$x_"

        local i=1
        while [ "$i" -le "$count" ]; do
            {
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
            } 1>/dev/null 2>/dev/null
            ___x_cmd_epoch_real_; printf "%s\n" "$x_"
            i=$((i+1))
        done
    ) | {
        ___x_cmd_cmds awk -v "batch=10" -v "output=$outputmode" -f "${___X_CMD_ROOT_MOD}/time/lib/report.awk"
    }
}
