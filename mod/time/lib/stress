___x_cmd_time_stress___main10(){
    local count="$1" ;  shift
    local x_
    (
        ___x_cmd_epoch_real_; printf "%s\n" "$x_"

        local i=1
        while [ "$i" -le "$count" ]; do
            {
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
                "$@"
            } 1>/dev/null 2>/dev/null
            ___x_cmd_epoch_real_; printf "%s\n" "$x_"
            i=$((i+1))
        done
    ) | {
        ___x_cmd_cmds awk -v "batch=10" -v "offset=$OFFSET" -v "output=$OUTPUT" -f "${___X_CMD_ROOT_MOD}/time/lib/report.awk"
    }
}
