
___x_cmd_time_try(){
    arg:init time
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)  ___x_cmd help -m time --try "$@" ; return 0 ;;
            -c)         count="$2"; arg:2:shift ;;
            *)          break
        esac
    done

    local x_=""

    ___x_cmd_epoch_real_;      local begin="$x_"
    "$@"
    ___x_cmd_epoch_real_;      local end="$x_"

    local sum="$(( (end - begin) * 1000 ))"

    time:info   \
        --count             "$count"    \
        --sum-ms            "$sum"      \
        "Report ( unit: ms )"
}

