# shellcheck shell=dash

___x_cmd_top___main(){
    [ "$#" -gt 0 ] ||   set -- -e --battery

    local op="$1";  shift

    # Adding some ai features ...
    case "$op" in
        ,|--coco)       ___x_cmd_top___coco "$@"
                        ;;
        *)              ___x_cmd_top___cmd "$op" "$@"
                        return 1
                        ;;
    esac
}

___x_cmd_top___cmd(){
    if [ -t 1 ] && ___x_cmd_is_interactive; then
        ___x_cmd_top___app "$@"
    else
        command top
    fi
}

___x_cmd_top___app(){
    (
        ___x_cmd env try bottom
        btm "$@"
    )
}

___x_cmd_top___coco(){
    :
    # Trying to analysis the current system status
}

