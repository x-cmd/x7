___x_cmd_uninstall_ls___pixi(){
    ___x_cmd_hascmd pixi || return 0
    ___x_cmd pixi global list 2>/dev/null | \
        ___x_cmd awk -F: '/├──|└──/ { sub(/^├── /, "", $1); sub(/^└── /, "", $1); printf("%s\t%s\n", $1, "pixi"); }'
}

