___x_cmd_winget___proxy(){
    local op="$1";
    case "$op" in
        set)            shift; ___x_cmd_winget___proxy_set "$@"     ;;
        unset)          shift; ___x_cmd_winget___proxy_unset        ;;
        get)            shift; ___x_cmd_winget___proxy_get          ;;

        -h|--help)      ___x_cmd help -m winget proxy               ;;
        "")             ___x_cmd help -m winget proxy >&2; return 64    ;;
        *)              N=winget M="Unsupported subcmd => $op" log:ret:64  ;;
    esac
}

___x_cmd_winget___proxy_set(){
    local ip=; local interface=
    [ -n "$1" ] ||{
        winget:error "Please provide a correct format of proxy setting; e.g. ---> 127.0.0.1:7070"
        return 1
    }

    interface=${1#*:}; ip=${1%:*}

    if ! ___x_cmd is int "$interface"; then
        winget:error "Please provide a correct format of proxy setting; e.g. ---> 127.0.0.1:7070"
        return 1
    fi

    if ! ___x_cmd is ip "$ip"; then
        winget:error "Please provide a correct format of proxy setting; e.g. ---> 127.0.0.1:7070"
        return 1
    fi
    ___x_cmd_winget_cfg___invoke   set  proxy="${ip}:${interface}"
}

___x_cmd_winget___proxy_get(){
    ___x_cmd_winget_cfg___invoke get proxy 2>/dev/null
}

___x_cmd_winget___proxy___use(){
    [ -f "$___X_CMD_WINGET_CFG" ] || return 0
    local proxy=; proxy="$(___x_cmd_winget___proxy_get)"
    [ -n "$proxy" ] ||return 0

    https_proxy=http://"$proxy"; http_proxy=http://"$proxy"; all_proxy=socks5://"$proxy"
}

___x_cmd_winget___proxy_unset(){
    ___x_cmd_winget_cfg___invoke   clear
}
